+    assert out["emit_rate_ratio"] != pytest.approx(1.0)
+    assert out["emit_rate_n_samples"] == 8
+    assert out["emit_events_total"] == 80
+    assert out["emit_person_ticks_total"] == 42
+    assert out["emit_rate_window_frac"] == 0.25
