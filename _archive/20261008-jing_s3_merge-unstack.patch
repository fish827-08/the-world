+    out = _M0Instruments().emit_pooled(rows, window_frac=0.25)
+    # 首段 = 行 0..1 ⇒ Δev=20 / Δpt=10 = 2.0；末段 = 行 6..7 ⇒ 20 / (42-30) = 5/3
+    assert out["emit_rate_first"] == pytest.approx(2.0)
