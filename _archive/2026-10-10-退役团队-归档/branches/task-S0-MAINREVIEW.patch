 # ------------------------------------------------------------------ ③ fail-loud
 
+def _ext_usable() -> bool:
+    """本环境是否具备**可用的**编译扩展（`sim_core` 可导入且带关键符号）。
+
+    🔴 不用 `find_spec` 判存在——仓库自带 `sim_core/` 源码目录在未编译机上会成为
+    **命名空间空包**（`sphere_engine.py:778-790` R249 实录），`find_spec` 返回 spec 但
+    模块是空的 ⇒ 用它判档会把 B-2 的第二形误判成"有扩展"，反成新的红。
+    """
+    try:
+        import sim_core
+    except Exception:
+        return False
+    return hasattr(sim_core, "step_vectors_stage1")
+
+
 def test_fail_loud_rust_path() -> None:
-    """③ Rust 路径 + 开探针 ⇒ 构造期硬失败（不放行 = 白跑一整批空 sidecar）。"""
+    """③ Rust 路径 + 开探针 ⇒ 构造期硬失败（不放行 = 白跑一整批空 sidecar）。
+
+    🔴 **镜 B-2 修法**（`dd6066c`，PI 22:4x 落"不判红、不阻塞、修法归澜舟"）：本例原先
+    只收 `ValueError` ⇒ 在**无可用 Rust 扩展**的机器上，引擎的扩展守卫（`:770-790`，位于
+    探针闸门 `:900` **之前**）先抛 `RuntimeError`，探针闸门根本没被执行 ⇒ 该处不可复算。
+    两形都收，且各证一事（**不许**退化成"抛了就算过"）：
+      · `ValueError` ⇒ 证**探针闸门**在（消息必须 match 闸门文案）；
+      · `RuntimeError` ⇒ 只允许出现在**本环境确实没有可用扩展**时，且消息必须指向扩展缺失
+        （`sim_core`／`maturin`／Rust）；有扩展却抛 RuntimeError ⇒ = 闸门没被执行 ⇒ 照红。
+    ⇒ 两档环境都必须"构造失败"，白跑空 sidecar 的防线都成立。**出数批 manifest 须声明
+    有/无 `sim_core`**（R401① 独立复算门对齐所需；本批读数原始件已按此登记）。
+    """
     cfg = _base_cfg()
     cfg.simulation.use_sim_core = True
     cfg.energy_probe = EnergyProbeConfig(enabled=True)
-    with pytest.raises(ValueError, match="energy_probe.enabled=True"):
+    with pytest.raises((ValueError, RuntimeError)) as excinfo:
         SphereEngine(cfg)
+    err = excinfo.value
+    if isinstance(err, ValueError):
+        assert "energy_probe.enabled=True" in str(err), (
+            f"ValueError 但不是探针闸门 ⇒ {err}"
+        )
+    else:
+        assert not _ext_usable(), (
+            "本环境有可用 sim_core 扩展却撞 RuntimeError ⇒ 探针闸门没被执行到，"
+            f"B-2 第二形不成立（消息：{err}）"
+        )
+        msg = str(err)
+        assert ("sim_core" in msg) or ("maturin" in msg) or ("Rust" in msg) or (
+            "rust" in msg
+        ), f"无扩展环境的 RuntimeError 必须指向扩展缺失，实得：{msg}"
 
 
