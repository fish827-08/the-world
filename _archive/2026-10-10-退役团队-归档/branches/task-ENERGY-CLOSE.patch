@@ -0,0 +1,305 @@
+"""ENERGY-CLOSE 步A · 5 腿量级读数原始件生成器（读数入库用，非结论复算）。
+
+口径来源
+--------
+协议照 v0（`docs/设计文档/记录-ENERGY-CLOSE步A-旧装置逃逸量级前置实测-20261007.md`
+§一装置表）：**微型档** 60×120（7,200 格）｜初始种群 **200（仓库默认，见下勘注）**｜
+斑块 30｜`resource_dynamics` 关｜`corpse_enabled` 关｜`predation.enabled` 开（默认）｜
+`use_sim_core=False`（账本与探针只在 Python 路径刷）。seed 7/8/9 × 1,500 tick，
+`row_every=50` ⇒ 30 行/run。
+
+🔴 用途边界（PI 裁原样，板 @`7ddafa0` 四）：本件**只出量级/点火阻塞判据**，
+不是"能量偏差全账闭合"，也不是 S0 结论发布证据。S0 复算**不复用本探针链路**
+（R394）⇒ 复算脚本届时另立。5/7 腿 = **下界**，`esc_pred_e`/`esc_pred_s` 未埋点
+⇒ 读数 `None`（未观测 ≠ 0，砚⑥）。
+
+与 v0 的差别：v0 用**账本反推**残差（只读累计量）；本件用**步A 正式埋点**直读
+逐通道流量 ⇒ 同一 档、同一 seed/tick/行频，可交叉印证。
+
+🔴 **档勘注（复现时实测钉死，2026-10-09）**：出数那一批（板 @`7ddafa0`）跑的是
+**仓库默认初始种群 200**，不是 10-07 v0 装置表的 400 —— seed7 关/开 digest
+`(670522, 88366.190893)` + `rng_draws=23269` 只在 pop=200 复现（pop=400 实测得
+`(1239687, 150697.441427)` / 30820）。⇒ 板上「协议照 v0」那句**在初始种群这一项不成立**，
+本件按实测档入库并在 manifest 里登记该偏差；比例类结论不受影响（同档自洽），
+但**跨档绝对量级不可与 10-07 v0 直接比**。
+
+自检四条（镜 B-3 + R401① 全硬失败，不放行 = 白跑）
+------------------------------------------------
+① `ticks_run` 必须等于 `--ticks`（灭绝早停 ⇒ 报错，不静默少跑）；
+② `rows_emitted > 0`（行频写错 = 整批空 sidecar）；
+③ manifest 声明本环境**有/无**可用 `sim_core` 编译扩展（命名空间空包不算有）；
+④ `--check-board`（默认开）：seed7 digest 与 5 腿累计必须与上板读数逐位对上，
+   对不上 ⇒ 报错禁入库（防"入库件"与"上板件"是两次不同的跑）。
+
+用法
+----
+    ../../.venv/Scripts/python.exe experiments/stepa_leg_readout.py \
+        --out <数据仓>/energy_close_stepA/leg_readout_20261009.json
+    # A/B（seed7 探针关/开 digest + rng_draws 逐位对拍）默认跑；--no-ab 可关
+    # --no-check-board 可关基线对账（换档探索时用，换档后读数不得沿用上板口径）
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import platform
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from simulation.config import EnergyProbeConfig, SimConfig      # noqa: E402
+from simulation.provenance import collect, validate             # noqa: E402
+from simulation.sphere_engine import (                          # noqa: E402
+    EP_CHANNELS, EP_IMPLEMENTED, SphereEngine,
+)
+
+# --- R98 纪律：Windows GBK 控制台兜底（非 ASCII print 会让脚本 rc=1 假失败）---
+try:
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
+except Exception:
+    pass
+
+V0_SEEDS = (7, 8, 9)
+V0_TICKS = 1500
+V0_ROW_EVERY = 50
+V0_POP = 200        # 🔴 = 仓库默认（出数批实测档，非 10-07 v0 的 400，见模块勘注）
+
+#: 上板读数（板 @`7ddafa0` §三，1500 tick 累计；digest/rng_draws 见 §二）。
+#: 键 = seed，值 = 5 腿累计；单位=能量，round(…, 6) 与 sidecar 同口径。
+BOARD_READOUT: dict[int, dict[str, float]] = {
+    7: {"dis_meta": 248848.38, "dis_move": 21330.90, "dis_attack": 67.70,
+        "dis_signal": 10801.30, "esc_death_e": 29869.18},
+    8: {"dis_meta": 221445.17, "dis_move": 20152.05, "dis_attack": 64.70,
+        "dis_signal": 9196.00, "esc_death_e": 35528.15},
+    9: {"dis_meta": 297313.91, "dis_move": 17794.96, "dis_attack": 57.70,
+        "dis_signal": 11396.80, "esc_death_e": 25892.72},
+}
+BOARD_DIGEST: dict[int, tuple[int, float]] = {7: (670522, 88366.190893)}
+BOARD_RNG_DRAWS: dict[int, int] = {7: 23269}
+
+
+def build_cfg(seed: int, *, pop: int, probe: bool, row_every: int) -> SimConfig:
+    """出数批档（显式覆盖仅 = 初始种群 + 探针开关；其余全走仓库默认）。"""
+    cfg = SimConfig(seed=int(seed))
+    cfg.simulation.use_sim_core = False
+    cfg.population.initial_count = int(pop)
+    if probe:
+        cfg.energy_probe = EnergyProbeConfig(enabled=True, row_every=int(row_every))
+    return cfg
+
+
+def _digest(e: SphereEngine) -> tuple[int, float]:
+    """与 `test_135_energy_calib._digest` / `test_energy_probe._digest` 同口径。"""
+    return (int(e._flat.sum()), round(float(e._energy.sum()), 6))
+
+
+def _ext_usable() -> bool:
+    """本环境是否有**可用**的 sim_core 编译扩展（命名空间空包 ⇒ False）。"""
+    try:
+        import sim_core
+    except Exception:
+        return False
+    return hasattr(sim_core, "step_vectors_stage1")
+
+
+def run_one(seed: int, args: argparse.Namespace, *, probe: bool) -> dict:
+    cfg = build_cfg(seed, pop=args.pop, probe=probe, row_every=args.row_every)
+    e = SphereEngine(cfg)
+    t0 = time.perf_counter()
+    ticks = 0
+    for _ in range(args.ticks):
+        if e.extinct:
+            break
+        e.step()
+        ticks += 1
+    wall = round(time.perf_counter() - t0, 3)
+
+    if ticks != args.ticks:
+        raise RuntimeError(
+            f"自检①失败：seed={seed} probe={probe} 只跑了 {ticks}/{args.ticks} tick"
+            f"（灭绝早停或中断）⇒ 本批读数不可与 v0 同档比，请调小 tick 或换档，"
+            f"不要混账"
+        )
+    totals = e.energy_probe_totals()
+    rows = e.energy_probe_rows()
+    if probe:
+        if int(totals["rows_emitted"]) <= 0:
+            raise RuntimeError(
+                f"自检②失败：seed={seed} 探针开档但 rows_emitted=0"
+                f"（row_every={args.row_every} 写错 = 整批空 sidecar 白跑）"
+            )
+        if int(totals["ticks_recorded"]) != args.ticks:
+            raise RuntimeError(
+                f"自检②失败：seed={seed} ticks_recorded="
+                f"{totals['ticks_recorded']} ≠ {args.ticks}"
+            )
+        if int(totals["rows_emitted"]) != len(rows):
+            raise RuntimeError(f"自检②失败：seed={seed} totals/rows 行数不一致")
+
+    return {
+        "seed": int(seed),
+        "probe_enabled": bool(probe),
+        "ticks_run": int(ticks),
+        "wall_seconds": wall,
+        "digest": list(_digest(e)),
+        "rng_draws": int(e.rng_draws),
+        "pop_n": int(len(e._id)),
+        "totals": totals if probe else {"enabled": False},
+        "rows": rows,
+        "_engine": e,
+    }
+
+
+def _reconcile_run(manifest: dict, r: dict) -> None:
+    """与上板读数逐位对账（板帖为 2 位小数**展示值** ⇒ 通道项按 round(…, 2) 比；
+    digest/rng_draws 是原样整数与 6 位小数，按精确等值比）。"""
+    s = int(r["seed"])
+    bad = manifest["board_reconcile"]["mismatches"]
+    if s in BOARD_DIGEST and tuple(r["digest"]) != tuple(BOARD_DIGEST[s]):
+        bad.append({"seed": s, "field": "digest",
+                    "board": list(BOARD_DIGEST[s]), "actual": r["digest"]})
+    if s in BOARD_RNG_DRAWS and int(r["rng_draws"]) != int(BOARD_RNG_DRAWS[s]):
+        bad.append({"seed": s, "field": "rng_draws",
+                    "board": BOARD_RNG_DRAWS[s], "actual": r["rng_draws"]})
+    for ch, board_v in BOARD_READOUT.get(s, {}).items():
+        actual = r["totals"].get(ch + "_sum")
+        if actual is None or round(float(actual), 2) != round(float(board_v), 2):
+            bad.append({"seed": s, "field": ch, "board": board_v, "actual": actual})
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--seeds", default=",".join(str(s) for s in V0_SEEDS))
+    ap.add_argument("--ticks", type=int, default=V0_TICKS)
+    ap.add_argument("--row-every", type=int, default=V0_ROW_EVERY)
+    ap.add_argument("--pop", type=int, default=V0_POP)
+    ap.add_argument("--no-ab", action="store_true", help="跳过 seed7 关/开对拍")
+    ap.add_argument("--no-check-board", action="store_true",
+                    help="跳过与上板读数（@7ddafa0）的逐位对账；换档探索时用")
+    ap.add_argument("--out", default="", help="读数 JSON 输出路径（必填才落盘）")
+    args = ap.parse_args()
+
+    if args.ticks < 1 or args.row_every < 1:
+        raise RuntimeError("ticks / row_every 必须 ≥ 1")
+    seeds = [int(x) for x in args.seeds.split(",") if x.strip()]
+    if not seeds:
+        raise RuntimeError("seeds 为空")
+    check_board = (not args.no_check_board
+                   and tuple(seeds) == V0_SEEDS and args.ticks == V0_TICKS
+                   and args.pop == V0_POP)
+    if not args.no_check_board and not check_board:
+        raise RuntimeError(
+            "默认要求与上板读数对账，但本次参数（seeds/ticks/pop）已偏离出数档 ⇒ "
+            "要么按原档跑，要么显式 --no-check-board 并在产物里另标新档，不许混档对账"
+        )
+
+    manifest = {
+        "tool": "experiments/stepa_leg_readout.py",
+        "purpose": "ENERGY-CLOSE 步A 5 腿量级读数原始件（点火阻塞判据，非结论复算）",
+        "caliber": {
+            "grid": "60x120（7,200 格，仓库默认微型档，非 480×960 正式档）",
+            "initial_count": args.pop, "patch_count": 30,
+            "resource_dynamics": "off", "corpse_enabled": "off",
+            "predation": "on（默认）", "use_sim_core": False,
+            "seeds": seeds, "ticks": args.ticks, "row_every": args.row_every,
+            "protocol_source": "记录-ENERGY-CLOSE步A-旧装置逃逸量级前置实测-20261007.md §一",
+            "deviation_note": (
+                "🔴 与 10-07 v0 装置表**唯一**偏差 = 初始种群：出数批实测用仓库默认 200"
+                "（非 v0 的 400）；seed7 digest (670522, 88366.190893) + rng_draws 23269 "
+                "仅在 pop=200 复现，pop=400 实测 (1239687, 150697.441427) / 30820。"
+                "⇒ 板帖「协议照 v0」在初始种群项不成立，本件按实测档入库；"
+                "比例结论同档自洽不受影响，绝对量级不与 v0 互比。"
+            ),
+        },
+        "channels": {"all": list(EP_CHANNELS),
+                     "implemented": list(EP_IMPLEMENTED),
+                     "uninstrumented_read_none": [c for c in EP_CHANNELS
+                                                  if c not in EP_IMPLEMENTED]},
+        "env": {
+            "python": sys.version.split()[0],
+            "platform": platform.platform(),
+            "sim_core_usable": _ext_usable(),
+        },
+        "board_reconcile": {"enabled": bool(check_board),
+                            "board_commit": "7ddafa0" if check_board else None,
+                            "mismatches": []},
+        "runs": [],
+    }
+
+    # ---- A/B：seed 首值 探针关 vs 开 ⇒ digest + rng_draws 逐位对拍（R401 第一层）----
+    first = run_one(seeds[0], args, probe=True)
+    if not args.no_ab:
+        off = run_one(seeds[0], args, probe=False)
+        ab = {
+            "seed": seeds[0], "arm_off_digest": off["digest"], "arm_on_digest": first["digest"],
+            "arm_off_rng_draws": off["rng_draws"], "arm_on_rng_draws": first["rng_draws"],
+            "bit_equal": off["digest"] == first["digest"],
+            "rng_equal": off["rng_draws"] == first["rng_draws"],
+        }
+        del off["_engine"]
+        manifest["ab_check"] = ab
+        if not ab["bit_equal"] or not ab["rng_equal"]:
+            raise RuntimeError(
+                f"A/B 对拍失败：探针开档改动了行为 {ab} ⇒ 探针不再是只读，禁入库"
+            )
+        print(f"[A/B] seed={seeds[0]} bit_equal={ab['bit_equal']} "
+              f"rng_equal={ab['rng_equal']} digest={tuple(ab['arm_on_digest'])} "
+              f"rng_draws={ab['arm_on_rng_draws']}")
+    else:
+        manifest["ab_check"] = None
+    manifest["runs"].append(first)
+
+    for s in seeds[1:]:
+        r = run_one(s, args, probe=True)
+        manifest["runs"].append(r)
+
+    if check_board:
+        for r in manifest["runs"]:
+            _reconcile_run(manifest, r)
+        mis = manifest["board_reconcile"]["mismatches"]
+        if mis:
+            raise RuntimeError(
+                "自检④失败：与上板读数 @7ddafa0 对账不齐 ⇒ 本次产物不是上板那批，"
+                f"禁入库（先查档/代码漂移）。差异：{json.dumps(mis, ensure_ascii=False)}"
+            )
+        print(f"[对账] 与板 @7ddafa0 逐位齐：digest/rng_draws/5 腿累计 ×"
+              f"{len(manifest['runs'])} run 全中")
+
+    prov = collect(build_cfg(seeds[0], pop=args.pop, probe=True,
+                             row_every=args.row_every),
+                   rng_draws=first["rng_draws"])
+    validate(prov)
+    manifest["provenance"] = prov
+
+    for r in manifest["runs"]:
+        del r["_engine"]
+
+    print(f"\n===== {len(EP_IMPLEMENTED)} 腿累计流量（{args.ticks} tick，"
+          f"单位=能量，非净额）=====")
+    hdr = "seed | " + " | ".join(f"{c:>12}" for c in EP_IMPLEMENTED)
+    print(hdr)
+    for r in manifest["runs"]:
+        cells = []
+        for c in EP_IMPLEMENTED:
+            v = r["totals"].get(c + "_sum")
+            cells.append(f"{v:>12.2f}" if v is not None else f"{'None':>12}")
+        print(f"{r['seed']:>4} | " + " | ".join(cells))
+
+    if args.out:
+        out = Path(args.out)
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(json.dumps(manifest, ensure_ascii=False, indent=1,
+                                  sort_keys=True) + "\n", encoding="utf-8",
+                       newline="\n")
+        print(f"\n[落盘] {out}（runs={len(manifest['runs'])}，"
+              f"每 run rows={len(manifest['runs'][0]['rows'])}）")
+    else:
+        print("\n[未落盘] 未给 --out ⇒ 仅打印；入库请指定 --out（读数原始件必须落盘）")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
