+{
+  "_comment": "R396-CI 豁免清单入库（合 main 后三查 postmerge_check 的空列豁免登记表）。每条=一次显式放宽，须带理由/批次出处/批准人，可审计。工具本体不变：--allow-empty-col 仍逐项放行，本文件是其版本化来源。新增条目须上板/PI 确认，不代裁。",
+  "_schema": {
+    "column": "被豁免的整列全空/全NaN列名（对应 postmerge_check --allow-empty-col）",
+    "reason": "为什么该列本应 n/a（装置口径/判据层事实，非'跑歪了'）",
+    "batch": "首个触发该红的具体批次/产物（出处，可追溯）",
+    "approved_by": "批准放宽的角色（空列=装置本应无值，须装置线/PI 背书）",
+    "date": "登记日期",
+    "scope": "生效范围：always=长期豁免 / batch=<代号>=仅该批考古（新合并默认不套用带批豁免）"
+  },
+  "exemptions": [
+    {
+      "column": "g4_mem_bit_frac",
+      "reason": "G4 装置位元组占比在本实验臂配置下本应 n/a（装置无该通道），非静默零列族，属预期空列。",
+      "batch": "the-world-data/m1_smoke @53083d6（R396-POSTMERGE 真数据首跑：PASS=23 FAIL=0 仅此列豁免）",
+      "approved_by": "澜舟（装置线）背书 + PI 合 c95f9e5；待 PI 复核正式化",
+      "date": "2026-10-05",
+      "scope": "always"
+    }
+  ]
+}
