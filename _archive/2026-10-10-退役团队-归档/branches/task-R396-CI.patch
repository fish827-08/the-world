+# .gitee-ci.yml —— 合 main 后自动门禁（R396-CI；postmerge_check 三查接入）
+#
+# ⚠️ 草案态，勿先激活/先合：硬依赖 = 镜审 task/R396-POSTMERGE@c95f9e5 ＋ PI 把
+#    `tools/postmerge_check.py` 合入 main 先行。工具未入库前本流水线会因
+#    `python tools/postmerge_check.py` 找不到文件而 exit 2（= fail-loud，正确报警）。
+#
+# 语义钉死（对上卡红线，不得弱化）：
+#   · 零机时：只读 the-world-data 已有产物，不跑批、不消费 RNG（R117）。
+#   · fail-loud：strict（默认，不加 --lenient）⇒ 有 SKIP 亦判红；退出码 0 绿 / 1 红 / 2 环境或用法错=红。
+#   · 不碰判据：任何"纪元级/装置覆盖"类不符，工具如实报 FAIL，本流水线**不豁免**（豁免只登记"装置本应 n/a 的空列"），代裁须 PI 走 --expect-device-field（澜舟侧下一步②）。
+#   · 豁免入库：空列豁免一律来自 tools/postmerge_exemptions.json（版本化、带理由+出处+批准人），CI 不接受命令行裸豁免。
+#
+# 真源：tools/postmerge_check.py（三查 C7/回显/完整性）｜tools/postmerge_exemptions.json｜AGENT.md §12.2 C7 / §十一 数据仓
+
+version: "1.0"
+name: postmerge-gate
+
+# Gitee CI runner 字段名以实际启用版本为准；若 runner 用 stages/steps 另形态，把 `jobs.*.steps[].run`
+# 整块平移即可——核心是下面这段 shell 序列，与本地"值班巡检一行调用"完全等价。
+triggers:
+  push:
+    branches: [main]
+
+jobs:
+  postmerge-check:
+    steps:
+      - name: selftest-钉工具完整性
+        run: |
+          set -e
+          PY="${PYTHON:-python}"
+          # 自检无需数据：改坏工具/误删计时列豁免 ⇒ 这里必红（性质①②③自锁）
+          "$PY" tools/postmerge_check.py --selftest
+
+      - name: 拉取数据仓产物（只读，零机时）
+        run: |
+          set -e
+          # 数据仓独立 git（remote=origin），本地已在 the-world-data/ ；CI 环境缺则浅克隆
+          if [ ! -d the-world-data ]; then
+            git clone --depth 1 https://gitee.com/little-fishy/the-world-data.git the-world-data
+          else
+            git -C the-world-data pull --ff-only origin main || true
+          fi
+
+      - name: 三查（strict，SKIP 亦红；豁免只从入库 JSON 取）
+        run: |
+          set -e
+          PY="${PYTHON:-python}"
+          # 从 tools/postmerge_exemptions.json 组装 --allow-empty-col（scope=always 或匹配本批）
+          EXEMPT=$("$PY" - <<'PYEOF'
+import json, sys
+try:
+    data = json.load(open("tools/postmerge_exemptions.json", encoding="utf-8"))
+except FileNotFoundError:
+    sys.stderr.write("🔴 缺 tools/postmerge_exemptions.json（豁免清单须入库）\n"); sys.exit(2)
+args = []
+for e in data.get("exemptions", []):
+    if e.get("scope", "always") == "always":
+        args += ["--allow-empty-col", e["column"]]
+print(" ".join(args))
+PYEOF
+)
+          # shellcheck-disable=SC2086  EXEMPT 故意不加引号以展开为多参数
+          "$PY" tools/postmerge_check.py --data-dir the-world-data --limit 40 $EXEMPT
+          # 退出码：0=全过(绿)；1=有FAIL或strict下SKIP(红)；2=环境/用法错(红·fail-loud)
+
+      - name: dry-run 退出码对照（值班巡检同此一行手动调用）
+        run: |
+          echo "巡检一行： python tools/postmerge_check.py --data-dir the-world-data --limit 40 \$(python -c \"import json;print(' '.join('--allow-empty-col '+e['column'] for e in json.load(open('tools/postmerge_exemptions.json'))['exemptions'] if e.get('scope','always')=='always'))\")"
+          echo "退出码： 0=全过绿 / 1=FAIL或SKIP红(strict) / 2=工具未入库或缺JSON=环境红 —— 绝不'没查也绿'"
