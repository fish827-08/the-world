+++ b/tools/yan_s0_perm_microbench.py
@@ -0,0 +1,48 @@
+# -*- coding: utf-8 -*-
+"""U2 峰标签置换 L=1000 单次耗时·合成微基准（砚 10-09，解析段 §三-4）。
+
+量级参考件，**非 #9 权威值**（权威＝标定批真数据单次实测，F0 §五-1）。
+纯 stdlib（禁 scipy——F0 §七 H3）；统计形照 F0 §三 U2-1：两峰簇间簇均值差，
+置换＝标签随机重贴 L 次，统计 |差| ≥ 观测值的次数（双侧）。
+
+用法：py tools/yan_s0_perm_microbench.py [--n 500] [--seeds 8] [--L 1000]
+"""
+from __future__ import annotations
+import argparse, random, statistics, time
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--n", type=int, default=500, help="合并后两簇个体总数（保守上界）")
+    ap.add_argument("--seeds", type=int, default=8)
+    ap.add_argument("--L", type=int, default=1000)
+    a = ap.parse_args()
+    rng = random.Random(90000)   # 仅基准可复现锚，正式置换 seed 规则随标定批 manifest 锁
+    vals = [rng.gauss(0.35, 0.08) for _ in range(a.n // 2)] + \
+           [rng.gauss(0.72, 0.08) for _ in range(a.n - a.n // 2)]
+    labels = [0] * (a.n // 2) + [1] * (a.n - a.n // 2)
+
+    def stat(ks):
+        g0 = [v for v, k in zip(vals, ks) if k == 0]
+        g1 = [v for v, k in zip(vals, ks) if k == 1]
+        if not g0 or not g1:
+            return 0.0
+        return abs(statistics.mean(g1) - statistics.mean(g0))
+
+    obs = stat(labels)
+    t0 = time.perf_counter()
+    ge = 0
+    ks = labels[:]
+    for _ in range(a.L):
+        rng.shuffle(ks)
+        if stat(ks) >= obs - 1e-12:
+            ge += 1
+    dt = time.perf_counter() - t0
+    print(f"n={a.n} seeds={a.seeds} L={a.L} obs={obs:.4f} p={(ge+1)/(a.L+1):.4f} "
+          f"wall={dt:.3f}s per_run={dt/a.L*1000:.3f}ms")
+    print(f"正式批外推（8 seed 逐对×4 批最坏 32 次）≈{dt*32:.1f}s [推断·量级]")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
