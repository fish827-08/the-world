+    assert n_hi > n_lo > 0.0, (n_lo, n_hi)             # 核越宽 ⇒ 远表型也算竞争者
+    assert w_b(0.6, n_lo, 1.0, land=Landscape(sigma_c=0.05)) !=         w_b(0.6, n_hi, 1.0, land=Landscape(sigma_c=0.4))   # B 臂必须随 ν 变
