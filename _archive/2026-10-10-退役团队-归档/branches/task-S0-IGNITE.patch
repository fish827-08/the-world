+    assert d[0] == d[1], "A 臂吃了 σ_C ⇒ 频率项漏进对照臂，双臂隔离破了"
+
+    mixed = [0.6, 0.6, 0.9, 0.3]
+    n_lo = nu_local(0.6, mixed, sigma_c=0.05)
