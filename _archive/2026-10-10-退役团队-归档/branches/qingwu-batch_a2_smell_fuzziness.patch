+#!/usr/bin/env python3
+"""
+批 A2：气味场「模糊信息 vs 精确信息」验证探针（R283 立项，fish 提议，青梧实施）。
+
+验证目标：气味场提供的是模糊近场梯度（红线安全）还是精确全局导航（违反罗盘红线）。
+
+方法1（距离-角度误差曲线）：
+  单斑块世界，记录每 tick 生物移动方向与「生物→斑块中心」方向的夹角，
+  按到斑块距离分组统计。精确信息应全距离误差≈0；模糊信息应误差随距离增大。
+
+方法2（远距投放寻获时间）：
+  统计每个生物首次到达斑块的时间。精确信息≈直奔（距离/速度）；模糊信息≈瞎逛+碰巧进气味范围。
+
+装置：patch_count=1（单斑块），默认随机投放（单斑块世界里随机≈远距投放）。
+两组：sm_on（food 气味 + use_in_move）vs sm_off（无气味）。
+输出：个体级轨迹 CSV（每 N tick 采样一次）+ 种群级汇总 CSV。
+
+🔴 只读记录，不改仿真逻辑；C7 digest 不变（新增探针不影响引擎）。
+"""
+import argparse
+import csv
+import os
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from simulation.config import SimConfig
+from simulation.sphere_engine import SphereEngine
+from experiments.steady_k_probe import rescale_config, apply_post_build
+
+
+# 与 S2/S3 同装置基线（k=2.5 时间压缩）
+DEVICE = dict(rows=480, cols=960, patches=1, pop=500, rgm=1.195,
+              bg_low_prod_frac=0.4, bg_low_cap_mult=0.05)
+S1_BASE = dict(rows=480, cols=960, speed_max=0.125, gain=0.125,
+               subdiv=80, k=2.5, max_count=30000)
+SEEDS_USED = set(range(42, 173))  # S2/S3/S3.5 已用区间
+
+
+def _patch_centroid(eng) -> tuple[int, int]:
+    """算斑块质心（行, 列）。单斑块世界用 patch_mask。"""
+    mask = getattr(eng.resources, "_patch_mask", None)
+    if mask is None or not mask.any():
+        return (eng.world.rows // 2, eng.world.cols // 2)
+    cells = np.flatnonzero(mask)
+    rr, cc = np.divmod(cells, eng.world.cols)
+    return (int(rr.mean()), int(cc.mean()))
+
+
+def _torus_direction(from_cell: np.ndarray, to_r: int, to_c: int,
+                     rows: int, cols: int) -> tuple[np.ndarray, np.ndarray]:
+    """算从 from_cell 到 (to_r, to_c) 的最短环面方向向量 (dr, dc)，范围 [-rows/2, rows/2] × [-cols/2, cols/2]。"""
+    fr, fc = np.divmod(from_cell, cols)
+    dr = to_r - fr
+    dc = to_c - fc
+    # 环面最短路径
+    dr = np.where(dr > rows // 2, dr - rows, dr)
+    dr = np.where(dr < -rows // 2, dr + rows, dr)
+    dc = np.where(dc > cols // 2, dc - cols, dc)
+    dc = np.where(dc < -cols // 2, dc + cols, dc)
+    return dr.astype(np.float64), dc.astype(np.float64)
+
+
+def _angle_error(move_dr: np.ndarray, move_dc: np.ndarray,
+                 target_dr: np.ndarray, target_dc: np.ndarray) -> np.ndarray:
+    """算移动方向与目标方向的夹角（度）。不移动（0,0）的个体返回 NaN。"""
+    move_norm = np.sqrt(move_dr ** 2 + move_dc ** 2)
+    target_norm = np.sqrt(target_dr ** 2 + target_dc ** 2)
+    valid = (move_norm > 1e-9) & (target_norm > 1e-9)
+    cos_angle = np.zeros_like(move_norm)
+    cos_angle[valid] = ((move_dr[valid] * target_dr[valid] + move_dc[valid] * target_dc[valid])
+                        / (move_norm[valid] * target_norm[valid]))
+    cos_angle = np.clip(cos_angle, -1.0, 1.0)
+    degrees = np.degrees(np.arccos(cos_angle))
+    degrees[~valid] = np.nan
+    return degrees
+
+
+def _torus_distance(cells: np.ndarray, to_r: int, to_c: int,
+                    rows: int, cols: int) -> np.ndarray:
+    """环面欧几里得距离。"""
+    dr, dc = _torus_direction(cells, to_r, to_c, rows, cols)
+    return np.sqrt(dr ** 2 + dc ** 2)
+
+
+def run_one(seed: int, ticks: int, sample: int, smell_on: bool,
+            track_every: int = 5) -> tuple[list[dict], list[dict], dict]:
+    """跑一个 run，返回 (汇总行列表, 轨迹行列表, meta)。"""
+    c = SimConfig(seed=seed)
+    c.world.rows, c.world.cols = DEVICE["rows"], DEVICE["cols"]
+    c.resources.distribution = "patchy"
+    c.resources.bg_production_zero = True
+    c.resources.patch_regeneration_mult = DEVICE["rgm"]
+    c.resources.patch_count = DEVICE["patches"]  # 🔴 单斑块
+    c.resources.bg_low_prod_frac = DEVICE["bg_low_prod_frac"]
+    c.resources.bg_cap_mult = DEVICE["bg_low_cap_mult"]
+    c.population.initial_count = DEVICE["pop"]
+    c.simulation.use_sim_core = False  # Python 路径（与 S2/S3 一致）
+    c.resource_dynamics.enabled = True  # rd 全开（与批 A 同装置）
+
+    if smell_on:
+        c.smell.channels = ("food",)
+        c.smell.use_in_move = True
+    else:
+        c.smell.channels = ()
+        c.smell.use_in_move = False
+
+    notes = rescale_config(c, S1_BASE["k"])
+    eng = SphereEngine(c)
+    apply_post_build(eng, notes)
+
+    patch_r, patch_c = _patch_centroid(eng)
+    rows, cols = eng.world.rows, eng.world.cols
+    N0 = len(eng._id)
+
+    # 记录初始位置（用于方法2的寻获时间）
+    init_flat = eng._flat[:N0].copy()
+    init_dist = _torus_distance(init_flat, patch_r, patch_c, rows, cols)
+
+    patch_mask = eng.resources._patch_mask.copy()
+
+    # ID → 上一 tick 位置（用于算个体移动方向）
+    prev_pos: dict[int, int] = {int(eng._id[i]): int(eng._flat[i]) for i in range(N0)}
+
+    # 寻获时间：ID → 首次到达斑块的 tick
+    first_patch: dict[int, int] = {}
+
+    summary_rows = []
+    track_rows = []
+    t0 = time.perf_counter()
+
+    for t in range(1, ticks + 1):
+        eng.step()
+        N = len(eng._id)
+        cur_ids = eng._id[:N]
+        cur_flat = eng._flat[:N]
+
+        # 寻获时间登记
+        if N > 0:
+            on_patch = patch_mask[cur_flat]
+            for i in range(N):
+                if on_patch[i]:
+                    oid = int(cur_ids[i])
+                    if oid not in first_patch:
+                        first_patch[oid] = t
+
+        # 轨迹采样（每 track_every tick）
+        if t % track_every == 0 and N > 0:
+            # 用 ID 匹配算个体移动方向
+            move_dr = np.full(N, np.nan)
+            move_dc = np.full(N, np.nan)
+            for i in range(N):
+                oid = int(cur_ids[i])
+                if oid in prev_pos:
+                    pf = prev_pos[oid]
+                    cf = int(cur_flat[i])
+                    if pf != cf:
+                        pdr, pdc = _torus_direction(np.array([pf]), 0, 0, rows, cols)
+                        cdr, cdc = _torus_direction(np.array([cf]), 0, 0, rows, cols)
+                        dr = float(cdr[0] - pdr[0])
+                        dc = float(cdc[0] - pdc[0])
+                        # 环面修正
+                        if dr > rows // 2: dr -= rows
+                        elif dr < -rows // 2: dr += rows
+                        if dc > cols // 2: dc -= cols
+                        elif dc < -cols // 2: dc += cols
+                        move_dr[i] = dr
+                        move_dc[i] = dc
+
+            # 到斑块方向和距离
+            tdr, tdc = _torus_direction(cur_flat, patch_r, patch_c, rows, cols)
+            dist = np.sqrt(tdr ** 2 + tdc ** 2)
+            angle_err = _angle_error(move_dr, move_dc, tdr, tdc)
+
+            # 气味值（sm_on 组才有）
+            smell_val = np.zeros(N)
+            if smell_on and eng.smell is not None:
+                smell_val = eng.smell.at(cur_flat, "food")
+
+            # 按距离分箱统计
+            bins = [0, 5, 10, 20, 30, 50, 80, 120, 200, 9999]
+            for bi in range(len(bins) - 1):
+                lo, hi = bins[bi], bins[bi + 1]
+                mask = (dist >= lo) & (dist < hi)
+                cnt = int(mask.sum())
+                if cnt == 0:
+                    continue
+                valid_angle = angle_err[mask]
+                valid_angle = valid_angle[~np.isnan(valid_angle)]
+                track_rows.append({
+                    "seed": seed, "arm": "sm_on" if smell_on else "sm_off",
+                    "tick": t, "dist_bin": f"{lo}-{hi}",
+                    "n": cnt,
+                    "n_moved": int(len(valid_angle)),
+                    "angle_mean": round(float(valid_angle.mean()), 2) if len(valid_angle) > 0 else "",
+                    "angle_median": round(float(np.median(valid_angle)), 2) if len(valid_angle) > 0 else "",
+                    "smell_mean": round(float(smell_val[mask].mean()), 4),
+                    "on_patch_frac": round(float(patch_mask[cur_flat[mask]].mean()), 4),
+                })
+
+        # 汇总采样（每 sample tick）
+        if t % sample == 0 or t == ticks:
+            N = len(eng._id)
+            dist = _torus_distance(eng._flat[:N], patch_r, patch_c, rows, cols) if N > 0 else np.array([])
+            on_patch = float(patch_mask[eng._flat[:N]].mean()) if N > 0 else 0.0
+            # 寻获率（到达过斑块的个体占初始种群的比例）
+            found_frac = round(len(first_patch) / max(N0, 1), 4)
+            summary_rows.append({
+                "seed": seed, "arm": "sm_on" if smell_on else "sm_off",
+                "tick": t, "pop": N,
+                "dist_mean": round(float(dist.mean()), 2) if N > 0 else "",
+                "dist_median": round(float(np.median(dist)), 2) if N > 0 else "",
+                "dist_min": round(float(dist.min()), 2) if N > 0 else "",
+                "on_patch_frac": round(on_patch, 4),
+                "found_frac": found_frac,
+                "ms_per_tick": round((time.perf_counter() - t0) / t * 1e3, 1),
+            })
+
+        # 更新上一 tick 位置字典
+        prev_pos = {int(cur_ids[i]): int(cur_flat[i]) for i in range(N)}
+
+    meta = {
+        "seed": seed, "arm": "sm_on" if smell_on else "sm_off",
+        "patch_centroid": f"({patch_r},{patch_c})",
+        "init_dist_mean": round(float(init_dist.mean()), 2),
+        "init_dist_median": round(float(np.median(init_dist)), 2),
+        "final_pop": len(eng._id),
+        "elapsed_sec": round(time.perf_counter() - t0, 1),
+    }
+    return summary_rows, track_rows, meta
+
+
+def main():
+    ap = argparse.ArgumentParser(description="批 A2：气味模糊性验证探针")
+    ap.add_argument("--seeds", type=str, default="173,174,175,176,177,178,179,180",
+                    help="逗号分隔种子（默认 173-180，与历史 42-172 错开）")
+    ap.add_argument("--ticks", type=int, default=2000)
+    ap.add_argument("--sample", type=int, default=100, help="汇总采样间隔")
+    ap.add_argument("--track-every", type=int, default=10, help="轨迹采样间隔（tick）")
+    ap.add_argument("--arms", type=str, default="both", choices=["both", "on", "off"])
+    ap.add_argument("--out", type=str, default="results/batch_a2_fuzziness.csv")
+    ap.add_argument("--track-out", type=str, default="results/batch_a2_track.csv")
+    ap.add_argument("--append", action="store_true")
+    args = ap.parse_args()
+
+    seeds = [int(x) for x in args.seeds.split(",") if x.strip()]
+    overlap = sorted(set(seeds) & SEEDS_USED)
+    if overlap:
+        print(f"🔴 种子 {overlap} 与已用区间 42-172 重叠 ⇒ 违反 R255。中止。", file=sys.stderr)
+        sys.exit(2)
+
+    arms = ([True, False] if args.arms == "both"
+            else [args.arms == "on"])
+
+    os.makedirs(os.path.dirname(args.out) or ".", exist_ok=True)
+    summary_header = ["seed", "arm", "tick", "pop", "dist_mean", "dist_median",
+                      "dist_min", "on_patch_frac", "found_frac", "ms_per_tick"]
+    track_header = ["seed", "arm", "tick", "dist_bin", "n", "n_moved", "angle_mean",
+                    "angle_median", "smell_mean", "on_patch_frac"]
+
+    need_header_s = (not args.append) or (not os.path.exists(args.out))
+    need_header_t = (not args.append) or (not os.path.exists(args.track_out))
+
+    all_summary = []
+    all_track = []
+    metas = []
+
+    for smell_on in arms:
+        for seed in seeds:
+            arm = "sm_on" if smell_on else "sm_off"
+            print(f"▶ seed={seed} arm={arm} ...", flush=True)
+            srows, trows, meta = run_one(seed, args.ticks, args.sample, smell_on, args.track_every)
+            all_summary.extend(srows)
+            all_track.extend(trows)
+            metas.append(meta)
+            print(f"  ✓ pop={meta['final_pop']} 耗时={meta['elapsed_sec']}s "
+                  f"初始距离均值={meta['init_dist_mean']} 斑块中心={meta['patch_centroid']}", flush=True)
+
+    # 写汇总 CSV
+    with open(args.out, "a" if args.append else "w", newline="", encoding="utf-8") as f:
+        w = csv.DictWriter(f, fieldnames=summary_header, extrasaction="ignore")
+        if need_header_s:
+            w.writeheader()
+        w.writerows(all_summary)
+
+    # 写轨迹 CSV
+    with open(args.track_out, "a" if args.append else "w", newline="", encoding="utf-8") as f:
+        w = csv.DictWriter(f, fieldnames=track_header, extrasaction="ignore")
+        if need_header_t:
+            w.writeheader()
+        w.writerows(all_track)
+
+    # summary.json
+    import json
+    out_json = os.path.splitext(args.out)[0] + ".summary.json"
+    with open(out_json, "w", encoding="utf-8") as f:
+        json.dump({"metas": metas, "n_summary_rows": len(all_summary),
+                   "n_track_rows": len(all_track), "config": vars(args)}, f, indent=2, ensure_ascii=False)
+
+    print(f"\n✅ 完成：{len(all_summary)} 汇总行 + {len(all_track)} 轨迹行")
+    print(f"   汇总：{args.out}")
+    print(f"   轨迹：{args.track_out}")
+    print(f"   meta：{out_json}")
+
+
+if __name__ == "__main__":
+    main()
