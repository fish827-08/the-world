+def _stratified_placement(eng, patch_r: int, patch_c: int,
+                          rings: list[int], per_ring: int,
+                          rng: np.random.Generator) -> dict[int, int]:
+    """分层投放：把前 len(rings)*per_ring 个生物按距离环投放。
+
+    每个环在以斑块中心为圆心、半径≈D 的圆上随机选点（球面模运算）。
+    返回 {id: 初始距离} 用于 meta 记录。
+    🔴 只改初始位置，不改能量/基因/世界规则。
+    """
+    rows, cols = eng.world.rows, eng.world.cols
+    N = min(len(eng._id), len(rings) * per_ring)
+    id_to_dist = {}
+    idx = 0
+    for D in rings:
+        for _ in range(per_ring):
+            if idx >= N:
+                break
+            # 圆上随机角度
+            theta = rng.uniform(0, 2 * np.pi)
+            dr = int(round(D * np.sin(theta)))
+            dc = int(round(D * np.cos(theta)))
+            r = (patch_r + dr) % rows
+            c = (patch_c + dc) % cols
+            cell = r * cols + c
+            eng._flat[idx] = cell
+            # 同步子位置（格中心）
+            if hasattr(eng, "_sub_r") and idx < len(eng._sub_r):
+                eng._sub_r[idx] = 0.5
+                eng._sub_c[idx] = 0.5
+            oid = int(eng._id[idx])
+            id_to_dist[oid] = D
+            idx += 1
+    return id_to_dist
+
