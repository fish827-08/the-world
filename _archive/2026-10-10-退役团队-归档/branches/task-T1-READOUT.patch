+"""tests/test_p1c_density_sweep.py — N2 载体靶向测试。
+
+覆盖：
+  ① plan 生成：12 run（D1/D2/D3 × 4 seed），D0 不入 plan
+  ② D0 复用：copy Tier-1 → density dir
+  ③ 复现门：逐行对拍 pass/fail
+  ④ collect_readings：读 summary.json 矩阵
+  ⑤ judge_density：S1/S2/S3 三重锁 + 生态门
+  ⑥ format_matrix_markdown：附表格式
+  ⑦ fail-loud：缺探针/缺目录
+"""
+
+import csv
+import json
+import math
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from experiments.p1c_density_sweep import (
+    DENSITY_LEVELS,
+    SEEDS,
+    TICKS,
+    collect_readings,
+    format_matrix_markdown,
+    generate_plan,
+    judge_density,
+    repro_check,
+    reuse_d0,
+)
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+
+def _make_summary(pep_frac=0.90, pos_frac=0.86, pep_d_med=1.0,
+                  pos_d_med=1.0, extinct_at=None):
+    return {
+        "probe": "p1c_erasure_probe", "seed": 0, "ticks": 3000,
+        "extinct_at": extinct_at,
+        "pooled": {
+            "n_samples": 30,
+            "pos_frac_read_moore": pos_frac,
+            "pos_d_med": pos_d_med,
+            "pep": {"frac_read_moore": pep_frac, "d_med": pep_d_med},
+            "pep64": {"frac_read_moore": pep_frac - 0.01},
+        },
+    }
+
+
+def _write_density_summaries(data_dir: Path, entries: list):
+    """entries: [{label, patches, seed, summary_dict}]"""
+    data_dir.mkdir(parents=True, exist_ok=True)
+    for e in entries:
+        stem = f"p1c_density_{e['label']}_s{e['seed']}_t{TICKS}"
+        fp = data_dir / f"{stem}.summary.json"
+        fp.write_text(json.dumps(e["summary"]), encoding="utf-8")
+
+
+# ---------------------------------------------------------------------------
+# ① plan 生成
+# ---------------------------------------------------------------------------
+
+class TestGeneratePlan:
+    def test_12_runs_excludes_d0(self, tmp_path):
+        plan = generate_plan(tmp_path)
+        assert len(plan) == 12
+        labels = {e["label"] for e in plan}
+        assert labels == {"D1", "D2", "D3"}
+
+    def test_patches_in_range(self, tmp_path):
+        plan = generate_plan(tmp_path)
+        for e in plan:
+            assert e["patches"] in (850, 425, 213)
+
+    def test_seeds_207_to_210(self, tmp_path):
+        plan = generate_plan(tmp_path)
+        seed_set = set(e["seed"] for e in plan)
+        assert seed_set == {207, 208, 209, 210}
+
+    def test_cmd_contains_smoke(self, tmp_path):
+        plan = generate_plan(tmp_path)
+        for e in plan:
+            assert "--smoke" in e["cmd"]
+            assert "--device" in e["cmd"]
+            assert "s2" in e["cmd"]
+
+    def test_output_path_pattern(self, tmp_path):
+        plan = generate_plan(tmp_path)
+        for e in plan:
+            assert f"p1c_density_{e['label']}_s{e['seed']}" in e["out"]
+
+
+# ---------------------------------------------------------------------------
+# ② D0 复用
+# ---------------------------------------------------------------------------
+
+class TestReuseD0:
+    def _make_tier1(self, tmp_path, seeds=SEEDS):
+        tier1 = tmp_path / "tier1"
+        tier1.mkdir()
+        for s in seeds:
+            stem = f"p1c_erase_s{s}_t{TICKS}"
+            (tier1 / f"{stem}.csv").write_text("tick,x\n100,1\n")
+            (tier1 / f"{stem}.summary.json").write_text(
+                json.dumps(_make_summary(0.90, 0.86, 1.0)), encoding="utf-8")
+        return tier1
+
+    def test_copies_all_four_seeds(self, tmp_path):
+        tier1 = self._make_tier1(tmp_path)
+        dest = tmp_path / "density"
+        actions = reuse_d0(tier1, dest)
+        assert len(actions) == 4
+        assert all(a["status"] == "copied" for a in actions)
+        for s in SEEDS:
+            fp = dest / f"p1c_density_D0_s{s}_t{TICKS}.summary.json"
+            assert fp.exists()
+
+    def test_missing_src_reports(self, tmp_path):
+        tier1 = tmp_path / "empty_tier1"
+        tier1.mkdir()
+        dest = tmp_path / "density"
+        actions = reuse_d0(tier1, dest)
+        assert all(a["status"] == "missing" for a in actions)
+
+    def test_idempotent(self, tmp_path):
+        tier1 = self._make_tier1(tmp_path)
+        dest = tmp_path / "density"
+        reuse_d0(tier1, dest)
+        actions2 = reuse_d0(tier1, dest)
+        assert all(a["status"] == "already_exists" for a in actions2)
+
+
+# ---------------------------------------------------------------------------
+# ③ 复现门
+# ---------------------------------------------------------------------------
+
+class TestReproCheck:
+    def _make_csv(self, path: Path, rows: list):
+        fieldnames = ["tick", "pep_frac_read_moore", "pep_d_med",
+                      "pos_frac_read_moore", "ms_per_tick_window"]
+        with path.open("w", newline="", encoding="utf-8") as f:
+            w = csv.DictWriter(f, fieldnames=fieldnames)
+            w.writeheader()
+            for r in rows:
+                w.writerow(r)
+
+    def test_identical_passes(self, tmp_path):
+        rows = [
+            {"tick": "100", "pep_frac_read_moore": "0.90", "pep_d_med": "1.0",
+             "pos_frac_read_moore": "0.86", "ms_per_tick_window": "79.74"},
+        ]
+        a = tmp_path / "a.csv"; b = tmp_path / "b.csv"
+        self._make_csv(a, rows)
+        self._make_csv(b, rows)
+        ok, diffs = repro_check(a, b)
+        assert ok and diffs == []
+
+    def test_ms_per_tick_excluded(self, tmp_path):
+        rows_a = [{"tick": "100", "pep_frac_read_moore": "0.90", "pep_d_med": "1.0",
+                    "pos_frac_read_moore": "0.86", "ms_per_tick_window": "79.74"}]
+        rows_b = [{"tick": "100", "pep_frac_read_moore": "0.90", "pep_d_med": "1.0",
+                    "pos_frac_read_moore": "0.86", "ms_per_tick_window": "99.99"}]
+        a = tmp_path / "a.csv"; b = tmp_path / "b.csv"
+        self._make_csv(a, rows_a); self._make_csv(b, rows_b)
+        ok, _ = repro_check(a, b)
+        assert ok
+
+    def test_value_diff_fails(self, tmp_path):
+        rows_a = [{"tick": "100", "pep_frac_read_moore": "0.90", "pep_d_med": "1.0",
+                    "pos_frac_read_moore": "0.86", "ms_per_tick_window": "79.74"}]
+        rows_b = [{"tick": "100", "pep_frac_read_moore": "0.85", "pep_d_med": "1.0",
+                    "pos_frac_read_moore": "0.86", "ms_per_tick_window": "79.74"}]
+        a = tmp_path / "a.csv"; b = tmp_path / "b.csv"
+        self._make_csv(a, rows_a); self._make_csv(b, rows_b)
+        ok, diffs = repro_check(a, b)
+        assert not ok
+        assert any("pep_frac_read_moore" in d for d in diffs)
+
+    def test_missing_file_returns_fail(self, tmp_path):
+        ok, diffs = repro_check(tmp_path / "nonexistent.csv", tmp_path / "no2.csv")
+        assert not ok
+
+
+# ---------------------------------------------------------------------------
+# ④ collect_readings
+# ---------------------------------------------------------------------------
+
+class TestCollectReadings:
+    def test_reads_all_density_levels(self, tmp_path):
+        entries = []
+        for level in DENSITY_LEVELS:
+            for seed in SEEDS:
+                entries.append({
+                    "label": level["label"], "patches": level["patches"], "seed": seed,
+                    "summary": _make_summary(
+                        pep_frac=0.80, pos_frac=0.50,
+                        pep_d_med=2.5, pos_d_med=2.8),
+                })
+        _write_density_summaries(tmp_path, entries)
+        matrix = collect_readings(tmp_path)
+        assert len(matrix) == 4
+        for label in matrix:
+            assert len(matrix[label]) == 4
+
+    def test_missing_seed_shows_error(self, tmp_path):
+        _write_density_summaries(tmp_path, [
+            {"label": "D1", "patches": 850, "seed": 207, "summary": _make_summary()},
+        ])
+        matrix = collect_readings(tmp_path)
+        assert "error" in matrix["D1"][208]
+
+
+# ---------------------------------------------------------------------------
+# ⑤ judge_density
+# ---------------------------------------------------------------------------
+
+class TestJudgeDensity:
+    def _build_matrix(self, pos_val, pep_val=0.85, d_med=2.0, pos_d=3.0):
+        m = {}
+        for label in ["D0", "D1", "D2", "D3"]:
+            m[label] = {}
+            for seed in SEEDS:
+                m[label][seed] = {
+                    "pos_frac_read_moore": pos_val,
+                    "pep_frac_read_moore": pep_val,
+                    "pep_d_med": d_med,
+                    "pos_d_med": pos_d,
+                    "delta_R": pos_val - pep_val,
+                    "extinct_at": None,
+                    "survived": True,
+                }
+        return m
+
+    def test_all_below_050_triggers_h2(self):
+        m = self._build_matrix(pos_val=0.40, pep_val=0.50, pos_d=3.5)
+        v = judge_density(m)
+        for label in ["D1", "D2", "D3"]:
+            assert v[label]["band"] == "H2"
+
+    def test_all_above_080_triggers_h1(self):
+        m = self._build_matrix(pos_val=0.90, pep_val=0.90, pos_d=1.0)
+        v = judge_density(m)
+        for label in ["D1", "D2", "D3"]:
+            assert v[label]["band"] == "H1"
+
+    def test_eco_gate_fail(self):
+        m = self._build_matrix(pos_val=0.40, pep_val=0.50, pos_d=3.5)
+        m["D2"][207]["survived"] = False
+        m["D2"][208]["survived"] = False
+        v = judge_density(m)
+        assert v["D2"]["gate"] == "FAIL"
+
+    def test_gray_zone_050_to_080(self):
+        m = self._build_matrix(pos_val=0.65, pep_val=0.85, pos_d=2.0)
+        v = judge_density(m)
+        for label in ["D1", "D2", "D3"]:
+            assert v[label]["band"] == "gray"
+
+    def test_d0_anomaly_warning(self):
+        m = self._build_matrix(pos_val=0.40, pep_val=0.50, pos_d=3.5)
+        v = judge_density(m)
+        assert "warning" in v.get("D0", {})
+
+    def test_s2_margin_fail(self):
+        """3/4 seeds below 0.50 but pool barely under boundary → S2 fails."""
+        m = self._build_matrix(pos_val=0.30, pep_val=0.50, pos_d=3.5)
+        m["D1"][210]["pos_frac_read_moore"] = 0.49
+        v = judge_density(m)
+        assert not v["D1"]["S2"]
+
+
+# ---------------------------------------------------------------------------
+# ⑥ format_matrix_markdown
+# ---------------------------------------------------------------------------
+
+class TestFormatMatrix:
+    def test_contains_all_density_labels(self):
+        m = {lbl: {s: {"error": "?"} for s in SEEDS} for lbl in ["D0", "D1", "D2", "D3"]}
+        v = judge_density(m)
+        md = format_matrix_markdown(m, v)
+        for lbl in ["D0", "D1", "D2", "D3"]:
+            assert lbl in md
+
+    def test_concludes_no_adjudication(self):
+        m = {}
+        v = {}
+        md = format_matrix_markdown(m, v)
+        assert "判读权归砚" in md
