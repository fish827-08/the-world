-    return "\n".join(lines)
-
-
-def main():
-    ap = argparse.ArgumentParser(description="Tier-1 擦除集判读（summary.json → 附表 + 结论）")
-    ap.add_argument("--data-dir", default=None,
-                    help="summary.json 所在目录（默认：仓库根 the-world-data/p1c_erase/）")
-    ap.add_argument("--out", default=None, help="输出 Markdown 路径（默认 stdout）")
