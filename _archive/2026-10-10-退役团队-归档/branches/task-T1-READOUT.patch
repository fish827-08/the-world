+#!/usr/bin/env python3
+"""N2 密度梯度批载体（R367 甲案）：编排 p1c_erasure_probe × 四档 patches。
+
+预注册稿：docs/预注册/预注册-N1-密度梯度批-20261004.md §二/§五
+判据来源：§三 主判据 pos_frac_read_moore（逐对池化）首次 ≤0.50 的密度档
+
+四档：D0=1700(复用Tier-1) D1=850 D2=425 D3=213
+种子：207-210  采样：100  ticks：3000  ring-depth：64  装置：s2
+
+用法::
+
+    # 生成 plan（不跑批，R117）：
+    python experiments/p1c_density_sweep.py --dry-run
+
+    # 复现门（冒烟 1 run D0 vs Tier-1 逐行对拍）：
+    python experiments/p1c_density_sweep.py --repro-check
+
+    # 执行全部 12 run（需 fish 起跑令后方可）：
+    python experiments/p1c_density_sweep.py --execute
+
+    # 单 run（PI/云机手动）：
+    python experiments/p1c_density_sweep.py --execute --patches 850 --seed 207
+
+退出码：0=成功/plan 完成, 1=复现门失败, 2=执行错误, 3=前置缺失。
+"""
+
+import argparse
+import csv
+import json
+import math
+import shutil
+import subprocess
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple
+
+DENSITY_LEVELS = [
+    {"label": "D0", "patches": 1700, "tier1": True},
+    {"label": "D1", "patches": 850,  "tier1": False},
+    {"label": "D2", "patches": 425,  "tier1": False},
+    {"label": "D3", "patches": 213,  "tier1": False},
+]
+SEEDS = [207, 208, 209, 210]
+TICKS = 3000
+SAMPLE = 100
+RING_DEPTH = 64
+PROBE = Path(__file__).resolve().parent / "p1c_erasure_probe.py"
+PROBE_FALLBACK = Path(__file__).resolve().parent / "p1c_distance_probe.py"
+
+
+def _git_commit() -> str:
+    try:
+        return subprocess.check_output(
+            ["git", "rev-parse", "--short", "HEAD"],
+            text=True, stderr=subprocess.DEVNULL,
+        ).strip()
+    except Exception:
+        return "unknown"
+
+
+def _out_name(label: str, patches: int, seed: int) -> str:
+    return f"p1c_density_{label}_s{seed}_t{TICKS}"
+
+
+def _summary_path(data_dir: Path, label: str, seed: int, patches: int) -> Path:
+    return data_dir / f"{_out_name(label, patches, seed)}.summary.json"
+
+
+def _csv_path(data_dir: Path, label: str, seed: int, patches: int) -> Path:
+    return data_dir / f"{_out_name(label, patches, seed)}.csv"
+
+
+def _tier1_paths(tier1_dir: Path, seed: int) -> Tuple[Path, Path]:
+    stem = f"p1c_erase_s{seed}_t{TICKS}"
+    return tier1_dir / f"{stem}.csv", tier1_dir / f"{stem}.summary.json"
+
+
+# ---------------------------------------------------------------------------
+# D0 复用
+# ---------------------------------------------------------------------------
+
+def reuse_d0(tier1_dir: Path, density_dir: Path) -> List[dict]:
+    """Copy Tier-1 data into density dir as D0. Returns list of actions."""
+    actions = []
+    density_dir.mkdir(parents=True, exist_ok=True)
+    for seed in SEEDS:
+        src_csv, src_json = _tier1_paths(tier1_dir, seed)
+        dst_csv = density_dir / f"{_out_name('D0', 1700, seed)}.csv"
+        dst_json = density_dir / f"{_out_name('D0', 1700, seed)}.summary.json"
+        if not src_json.exists():
+            actions.append({"seed": seed, "status": "missing", "src": str(src_json)})
+            continue
+        if dst_json.exists():
+            actions.append({"seed": seed, "status": "already_exists"})
+            continue
+        shutil.copy2(src_csv, dst_csv)
+        shutil.copy2(src_json, dst_json)
+        actions.append({"seed": seed, "status": "copied", "dst": str(dst_json)})
+    return actions
+
+
+# ---------------------------------------------------------------------------
+# 复现门（§2.4）
+# ---------------------------------------------------------------------------
+
+def repro_check(tier1_csv: Path, smoke_csv: Path) -> Tuple[bool, List[str]]:
+    """逐行对拍（排除 ms_per_tick_window）。返回 (pass, diff_lines)。
+
+    口径同 dm-guard（p1c_erasure_probe.py:60 风格）。
+    """
+    diffs = []
+    if not tier1_csv.exists():
+        return False, [f"Tier-1 锚文件不存在: {tier1_csv}"]
+    if not smoke_csv.exists():
+        return False, [f"冒烟产物不存在: {smoke_csv}"]
+
+    with tier1_csv.open(encoding="utf-8-sig") as f:
+        stored = list(csv.DictReader(f))
+    with smoke_csv.open(encoding="utf-8-sig") as f:
+        new = list(csv.DictReader(f))
+
+    if len(stored) != len(new):
+        return False, [f"行数不等：锚 {len(stored)} vs 新 {len(new)}"]
+
+    shared_cols = [c for c in stored[0] if c in new[0] and c != "ms_per_tick_window"]
+    for i, (sr, nr) in enumerate(zip(stored, new)):
+        for col in shared_cols:
+            sv, nv = sr.get(col, ""), nr.get(col, "")
+            if sv != nv:
+                try:
+                    if abs(float(sv) - float(nv)) < 1e-4:
+                        continue
+                except (ValueError, TypeError):
+                    pass
+                diffs.append(f"row {i} col {col}: 锚={sv!r} 新={nv!r}")
+    return len(diffs) == 0, diffs
+
+
+# ---------------------------------------------------------------------------
+# Plan 生成
+# ---------------------------------------------------------------------------
+
+def generate_plan(density_dir: Path) -> List[dict]:
+    """生成 12 run 的命令列表（D1/D2/D3 × 4 seeds）。"""
+    commit = _git_commit()
+    probe = PROBE if PROBE.exists() else (PROBE_FALLBACK if PROBE_FALLBACK.exists() else PROBE)
+    plan = []
+    for level in DENSITY_LEVELS:
+        if level["tier1"]:
+            continue
+        for seed in SEEDS:
+            out = density_dir / f"{_out_name(level['label'], level['patches'], seed)}.csv"
+            cmd = [
+                sys.executable, str(probe),
+                "--device", "s2",
+                "--seed", str(seed),
+                "--patches", str(level["patches"]),
+                "--ticks", str(TICKS),
+                "--sample", str(SAMPLE),
+                "--ring-depth", str(RING_DEPTH),
+                "--smoke",
+                "--out", str(out),
+            ]
+            plan.append({
+                "label": level["label"], "patches": level["patches"], "seed": seed,
+                "cmd": cmd, "out": str(out), "commit": commit,
+            })
+    return plan
+
+
+# ---------------------------------------------------------------------------
+# 执行
+# ---------------------------------------------------------------------------
+
+def execute_run(entry: dict, verbose: bool = True) -> dict:
+    """Run one density×seed combination. Returns result dict."""
+    cmd = entry["cmd"]
+    if verbose:
+        print(f"[{entry['label']} s{entry['seed']}] $ {' '.join(cmd[:6])} ...")
+    t0 = datetime.now(timezone.utc)
+    try:
+        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
+        rc = proc.returncode
+    except (subprocess.TimeoutExpired, OSError) as e:
+        rc = -1
+        proc = None
+
+    elapsed = (datetime.now(timezone.utc) - t0).total_seconds()
+    result = {
+        "label": entry["label"], "seed": entry["seed"],
+        "patches": entry["patches"], "rc": rc, "elapsed": round(elapsed, 1),
+        "out": entry["out"], "commit": entry.get("commit", "unknown"),
+    }
+    if rc != 0:
+        result["error"] = (proc.stderr[-500:] if proc else str("no proc"))
+    return result
+
+
+# ---------------------------------------------------------------------------
+# 读数收集 + 矩阵
+# ---------------------------------------------------------------------------
+
+def collect_readings(density_dir: Path) -> Dict[str, Dict[int, Dict]]:
+    """读全部 summary.json，收集主判据 + 辅助读数。返回 {label: {seed: data}}。"""
+    matrix = {}
+    for level in DENSITY_LEVELS:
+        label = level["label"]
+        matrix[label] = {}
+        for seed in SEEDS:
+            patches = level["patches"]
+            fp = _summary_path(density_dir, label, seed, patches)
+            if not fp.exists():
+                matrix[label][seed] = {"error": f"missing: {fp.name}"}
+                continue
+            try:
+                with fp.open(encoding="utf-8") as f:
+                    d = json.load(f)
+                p = d["pooled"]
+                extinct = d.get("extinct_at") is not None
+                row = {
+                    "pos_frac_read_moore": p["pos_frac_read_moore"],
+                    "pep_frac_read_moore": p["pep"]["frac_read_moore"],
+                    "pep_d_med": p["pep"]["d_med"],
+                    "pos_d_med": p.get("pos_d_med", float("nan")),
+                    "delta_R": p["pos_frac_read_moore"] - p["pep"]["frac_read_moore"],
+                    "extinct_at": d.get("extinct_at"),
+                    "survived": not extinct,
+                }
+                matrix[label][seed] = row
+            except Exception as e:
+                matrix[label][seed] = {"error": str(e)}
+    return matrix
+
+
+def judge_density(matrix: Dict) -> Dict:
+    """按 N1 预注册 §三/§四 判读（不替代砚判读稿，只出附表）。"""
+    verdicts = {}
+    for label in ["D1", "D2", "D3"]:
+        level_data = matrix.get(label, {})
+        alive = {s: d for s, d in level_data.items() if "error" not in d and d.get("survived")}
+        n_alive = len(alive)
+
+        if n_alive < 3:
+            verdicts[label] = {"gate": "FAIL", "reason": f"生态门不过（{n_alive}/4 存活）", "band": None}
+            continue
+
+        pos_vals = [d["pos_frac_read_moore"] for d in alive.values()]
+        pep_vals = [d["pep_frac_read_moore"] for d in alive.values()]
+        pool = sum(pos_vals) / len(pos_vals)
+
+        below = sum(1 for v in pos_vals if v <= 0.50)
+        s1_ok = below >= 3
+
+        if len(pos_vals) >= 2:
+            mu = sum(pos_vals) / len(pos_vals)
+            sd = math.sqrt(sum((x - mu) ** 2 for x in pos_vals) / (len(pos_vals) - 1))
+        else:
+            sd = 0.0
+
+        s2_ok = (0.50 - pool) >= 2 * sd if pool < 0.50 else False
+
+        d_med_vals = [d.get("pos_d_med", float("nan")) for d in alive.values()]
+        d_med_pool = sum(v for v in d_med_vals if not math.isnan(v)) / max(
+            1, sum(1 for v in d_med_vals if not math.isnan(v)))
+        pep_pool = sum(pep_vals) / len(pep_vals)
+        s3_ok = pep_pool <= 0.80 and d_med_pool >= 2.0
+
+        all_locks = s1_ok and s2_ok and s3_ok
+        verdicts[label] = {
+            "gate": "PASS", "pool": round(pool, 4), "sd": round(sd, 4),
+            "S1": s1_ok, "S2": s2_ok, "S3": s3_ok,
+            "band": "H2" if all_locks else ("gray" if pool <= 0.80 else "H1"),
+        }
+
+    d0 = matrix.get("D0", {})
+    d0_alive = {s: v for s, v in d0.items() if "error" not in v}
+    d0_pool = (sum(v["pos_frac_read_moore"] for v in d0_alive.values()) / len(d0_alive)) if d0_alive else None
+    if d0_pool is not None and d0_pool <= 0.50:
+        verdicts["D0"] = {"warning": "对照档 pos ≤ 0.50 — 异常，先查代码漂移"}
+
+    return verdicts
+
+
+def format_matrix_markdown(matrix: Dict, verdicts: Dict) -> str:
+    lines = [
+        "# N2 密度梯度批附表（4 档 × 4 seed）",
+        "",
+        "> 判据来源：`docs/预注册/预注册-N1-密度梯度批-20261004.md` §三",
+        "> 主判据 = `pos_frac_read_moore`（逐对池化）≤0.50 的**首个**密度档",
+        "",
+    ]
+
+    lines.append("| seed | D0(1700) | D1(850) | D2(425) | D3(213) |")
+    lines.append("|---:|---:|---:|---:|---:|")
+    for seed in SEEDS:
+        vals = []
+        for label in ["D0", "D1", "D2", "D3"]:
+            d = matrix.get(label, {}).get(seed, {})
+            if "error" in d or "pos_frac_read_moore" not in d:
+                vals.append("--")
+            elif not d.get("survived", True):
+                vals.append(f"ext@{d.get('extinct_at', '?')}")
+            else:
+                vals.append(f"{d['pos_frac_read_moore']:.4f}")
+        lines.append(f"| {seed} | {' | '.join(vals)} |")
+
+    lines += ["", "## 辅助读数（pos_frac / pep_frac / pep_d_med / ΔR / 存活）", ""]
+    lines.append("| 档 | seed | pos_frac | pep_frac | pep_d_med | dR | survived |")
+    lines.append("|---|---:|---:|---:|---:|---:|:---:|")
+    for level in DENSITY_LEVELS:
+        label = level["label"]
+        for seed in SEEDS:
+            d = matrix.get(label, {}).get(seed, {})
+            if "error" in d or "pos_frac_read_moore" not in d:
+                lines.append(f"| {label} | {seed} | -- | -- | -- | -- | -- |")
+                continue
+            lines.append(
+                f"| {label} | {seed} "
+                f"| {d['pos_frac_read_moore']:.4f} | {d['pep_frac_read_moore']:.4f} "
+                f"| {d['pep_d_med']:.4f} | {d['delta_R']:.4f} "
+                f"| {'Y' if d.get('survived') else 'N'} |"
+            )
+
+    lines += ["", "## 档级判读（附表，不替代砚判读稿）", ""]
+    lines.append("| 档 | 生态门 | 池化 pos | S1(≥3/4≤0.50) | S2(离界≥2SD) | S3(同向) | 带 |")
+    lines.append("|---|:---:|---:|:---:|:---:|:---:|:---:|")
+    for label in ["D0", "D1", "D2", "D3"]:
+        v = verdicts.get(label, {})
+        if "gate" not in v:
+            gate = "REF" if label == "D0" else "--"
+            pool = "--"
+            s1 = s2 = s3 = band = "--"
+        else:
+            gate = "F" if v["gate"] == "FAIL" else "P"
+            pool = str(v.get("pool", "--"))
+            s1 = "Y" if v.get("S1") else "N"
+            s2 = "Y" if v.get("S2") else "N"
+            s3 = "Y" if v.get("S3") else "N"
+            band = v.get("band", "--")
+        if "warning" in v:
+            band = "!! " + v["warning"]
+        lines.append(f"| {label} | {gate} | {pool} | {s1} | {s2} | {s3} | {band} |")
+
+    lines += ["", "---",
+              "**本附表由 `p1c_density_sweep.py` 自动生成。判读权归砚；本脚本不裁定。**",
+              ""]
+    return "\n".join(lines)
+
+
+# ---------------------------------------------------------------------------
+# 主入口
+# ---------------------------------------------------------------------------
+
+def main():
+    ap = argparse.ArgumentParser(description="N2 密度梯度批载体（R367 甲案）")
+    ap.add_argument("--dry-run", action="store_true", help="只生成 plan（默认行为）")
+    ap.add_argument("--execute", action="store_true", help="实际运行（需 fish 起跑令 R117）")
+    ap.add_argument("--repro-check", action="store_true", help="D0 复现门（冒烟 1 run vs Tier-1）")
+    ap.add_argument("--collect", action="store_true", help="收集已有产物出附表")
+    ap.add_argument("--patches", type=int, default=None, help="单 run：指定 patches")
+    ap.add_argument("--seed", type=int, default=None, help="单 run：指定 seed")
+    ap.add_argument("--density-dir", default="the-world-data/p1c_density",
+                    help="密度批产物目录")
+    ap.add_argument("--tier1-dir", default="the-world-data/p1c_erase",
+                    help="Tier-1 既有数据目录")
+    ap.add_argument("--out", default=None, help="附表输出路径（默认 stdout）")
+    args = ap.parse_args()
+
+    density_dir = Path(args.density_dir)
+    tier1_dir = Path(args.tier1_dir)
+
+    probe_exists = PROBE.exists() or PROBE_FALLBACK.exists()
+    if args.execute and not probe_exists:
+        print(f"探针脚本不存在: {PROBE} 或 {PROBE_FALLBACK}", file=sys.stderr)
+        print("  请先合入 T7-MERGE（轻舟 p1c_erasure_probe）", file=sys.stderr)
+        return 3
+
+    if args.collect:
+        if not density_dir.exists():
+            print(f"目录不存在: {density_dir}", file=sys.stderr)
+            return 3
+        matrix = collect_readings(density_dir)
+        verdicts = judge_density(matrix)
+        md = format_matrix_markdown(matrix, verdicts)
+        if args.out:
+            Path(args.out).parent.mkdir(parents=True, exist_ok=True)
+            Path(args.out).write_text(md, encoding="utf-8")
+        else:
+            print(md)
+        return 0
+
+    if args.repro_check:
+        print("D0 复现门：冒烟 run D0 × seed207 vs Tier-1 逐行对拍")
+        if not PROBE.exists() and not PROBE_FALLBACK.exists():
+            print("  探针不存在，无法冒烟（待 T7-MERGE 合入）", file=sys.stderr)
+            return 1
+        probe = PROBE if PROBE.exists() else PROBE_FALLBACK
+        smoke_out = density_dir / f"{_out_name('D0', 1700, 207)}.smoke.csv"
+        smoke_out.parent.mkdir(parents=True, exist_ok=True)
+        cmd = [
+            sys.executable, str(probe),
+            "--device", "s2", "--seed", "207", "--patches", "1700",
+            "--ticks", str(TICKS), "--sample", str(SAMPLE), "--ring-depth", str(RING_DEPTH),
+            "--out", str(smoke_out),
+        ]
+        print(f"  cmd: {' '.join(cmd[:6])}...")
+        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
+        if proc.returncode != 0:
+            print(f"  冒烟失败 RC={proc.returncode}: {proc.stderr[-300:]}", file=sys.stderr)
+            return 2
+        tier1_csv = tier1_dir / f"p1c_erase_s207_t{TICKS}.csv"
+        ok, diffs = repro_check(tier1_csv, smoke_out)
+        if ok:
+            print("  PASS：逐行一致，D0 可复用 Tier-1 全量数据")
+            reuse_actions = reuse_d0(tier1_dir, density_dir)
+            for a in reuse_actions:
+                print(f"    D0 s{a['seed']}: {a['status']}")
+        else:
+            print(f"  FAIL：{len(diffs)} 行不一致 → D0 须重跑 4 run")
+            for d in diffs[:5]:
+                print(f"    {d}")
+            return 1
+        return 0
+
+    plan = generate_plan(density_dir)
+
+    if args.patches is not None and args.seed is not None:
+        plan = [e for e in plan if e["patches"] == args.patches and e["seed"] == args.seed]
+    elif args.patches is not None:
+        plan = [e for e in plan if e["patches"] == args.patches]
+    elif args.seed is not None:
+        plan = [e for e in plan if e["seed"] == args.seed]
+
+    commit = _git_commit()
+    print(f"commit={commit}  plan={len(plan)} run(s)")
+    print(f"D0(1700): 复用 Tier-1（{tier1_dir}）")
+    print()
+
+    if not args.execute:
+        for e in plan:
+            print(f"  [{e['label']} s{e['seed']}] {' '.join(e['cmd'][-6:])}")
+        print()
+        print("  (默认 --dry-run，未执行。加 --execute 运行，需 fish 起跑令 R117)")
+        return 0
+
+    print("=== 执行中（已获起跑令）===")
+    results = []
+    for e in plan:
+        r = execute_run(e)
+        results.append(r)
+        status = "OK" if r["rc"] == 0 else f"RC={r['rc']}"
+        print(f"  [{r['label']} s{r['seed']}] {status} {r['elapsed']}s")
+
+    failed = [r for r in results if r["rc"] != 0]
+    print(f"\n完成：{len(results)-len(failed)} OK / {len(failed)} FAIL")
+    if failed:
+        for r in failed:
+            print(f"  FAIL [{r['label']} s{r['seed']}]: {r.get('error', '?')[:100]}")
+
+    print("\n=== 收集读数 ===")
+    matrix = collect_readings(density_dir)
+    verdicts = judge_density(matrix)
+    md = format_matrix_markdown(matrix, verdicts)
+    print(md)
+
+    return 2 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
