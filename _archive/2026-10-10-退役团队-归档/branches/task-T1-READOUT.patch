+"""tools/tier1_judge.py 边界靶向测试。
+
+覆盖（§3.1–3.3 设计-R358-T1）：
+  ① judge_single_metric 各指标边界：0.80/0.50 / 2.0/3.0 / 0.05/0.25（含方向）
+  ② read_p1c_csv：delta_R 现算（CSV 无此列）、缺列 fail-loud、NaN 过滤
+  ③ check_pool_margin：池化离带界 ≥2×种子间 SD
+  ④ check_consensus：≥3/4 seeds P1 同带
+  ⑤ compute_snr：(0.862 - pool) / seed_SD，§3.3.3 公式
+  ⑥ P1/P2 同向锁（§3.1）：异向 ⇒ "判据内冲突" ⇒ seed 无有效判
+  ⑦ 全流程：H1 / H2 / 不定（一致性不足）
+"""
+
+import csv
+import math
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from tools.tier1_judge import (
+    P1C_BASELINE,
+    THRESHOLDS,
+    check_consensus,
+    check_pool_margin,
+    compute_snr,
+    judge_single_metric,
+    judge_tier1,
+    load_all_seeds,
+    read_p1c_csv,
+)
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+
+def _write_synthetic_csv(path: Path, rows: list) -> None:
+    """Write minimal CSV with required columns."""
+    fieldnames = [
+        "tick", "pep_frac_read_moore", "pep_d_med",
+        "pos_frac_read_moore", "pep64_frac_read_moore",
+    ]
+    with path.open("w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(f, fieldnames=fieldnames)
+        writer.writeheader()
+        for r in rows:
+            r.setdefault("tick", 100)
+            r.setdefault("pep64_frac_read_moore", "0.82")
+            writer.writerow(r)
+
+
+def _write_seed_csvs(tmp_path: Path, seed_rows: dict) -> Path:
+    """seed_rows: {seed: [row_dict, ...]}，写到 tmp_path，返回 data_dir."""
+    data_dir = tmp_path / "data"
+    data_dir.mkdir()
+    for seed, rows in seed_rows.items():
+        fp = data_dir / f"p1c_erase_s{seed}_t3000.csv"
+        _write_synthetic_csv(fp, rows)
+    return data_dir
+
+
+# ---------------------------------------------------------------------------
+# ① judge_single_metric 边界（含方向）
+# ---------------------------------------------------------------------------
+
+class TestJudgeSingleMetric:
+    # P1: pep_frac_read_moore — high→H1
+    def test_pep_frac_h1_boundary_exact(self):
+        v, _ = judge_single_metric(0.80, "pep_frac_read_moore")
+        assert v == "H1"
+
+    def test_pep_frac_just_below_h1(self):
+        v, _ = judge_single_metric(0.799, "pep_frac_read_moore")
+        assert v is None  # gray
+
+    def test_pep_frac_h2_boundary_exact(self):
+        v, _ = judge_single_metric(0.50, "pep_frac_read_moore")
+        assert v == "H2"
+
+    def test_pep_frac_just_above_h2(self):
+        v, _ = judge_single_metric(0.501, "pep_frac_read_moore")
+        assert v is None
+
+    def test_pep_frac_nan_returns_none(self):
+        v, msg = judge_single_metric(float("nan"), "pep_frac_read_moore")
+        assert v is None
+        assert "NaN" in msg or "不足" in msg
+
+    # P2: pep_d_med — LOW→H1（距离小 = 历史都在近处 = H1）
+    def test_d_med_h1_boundary_exact(self):
+        v, _ = judge_single_metric(2.0, "pep_d_med")
+        assert v == "H1"
+
+    def test_d_med_below_h1(self):
+        v, _ = judge_single_metric(1.5, "pep_d_med")
+        assert v == "H1"
+
+    def test_d_med_h2_boundary_exact(self):
+        v, _ = judge_single_metric(3.0, "pep_d_med")
+        assert v == "H2"
+
+    def test_d_med_gray(self):
+        v, _ = judge_single_metric(2.5, "pep_d_med")
+        assert v is None
+
+    # ΔR: pos - pep — LOW→H1（差值小 = 历史≈近期 = H1）
+    def test_delta_r_h1_boundary_exact(self):
+        v, _ = judge_single_metric(0.05, "delta_R")
+        assert v == "H1"
+
+    def test_delta_r_negative_is_h1(self):
+        v, _ = judge_single_metric(-0.03, "delta_R")
+        assert v == "H1"
+
+    def test_delta_r_h2_boundary_exact(self):
+        v, _ = judge_single_metric(0.25, "delta_R")
+        assert v == "H2"
+
+    def test_delta_r_gray(self):
+        v, _ = judge_single_metric(0.15, "delta_R")
+        assert v is None
+
+
+# ---------------------------------------------------------------------------
+# ② read_p1c_csv
+# ---------------------------------------------------------------------------
+
+class TestReadP1cCsv:
+    def test_delta_r_computed_from_pos_minus_pep(self, tmp_path):
+        fp = tmp_path / "s207.csv"
+        _write_synthetic_csv(fp, [
+            {"pep_frac_read_moore": "0.90", "pep_d_med": "1.0", "pos_frac_read_moore": "0.86"},
+            {"pep_frac_read_moore": "0.88", "pep_d_med": "1.0", "pos_frac_read_moore": "0.84"},
+        ])
+        result = read_p1c_csv(str(fp))
+        assert "error" not in result
+        dr = result["pooled"]["delta_R"]
+        # delta_R = [0.86-0.90, 0.84-0.88] = [-0.04, -0.04] → mean = -0.04
+        assert dr["mean"] == pytest.approx(-0.04, abs=1e-9)
+
+    def test_missing_column_fails_loud(self, tmp_path):
+        fp = tmp_path / "s207.csv"
+        fp.write_text(
+            "tick,pep_frac_read_moore\n100,0.90\n",
+            encoding="utf-8",
+        )
+        result = read_p1c_csv(str(fp))
+        assert "error" in result
+        assert "missing_cols" in result
+        assert "pep_d_med" in result["missing_cols"]
+
+    def test_nan_rows_filtered(self, tmp_path):
+        fp = tmp_path / "s207.csv"
+        _write_synthetic_csv(fp, [
+            {"pep_frac_read_moore": "0.90", "pep_d_med": "1.0", "pos_frac_read_moore": "0.86"},
+            {"pep_frac_read_moore": "NaN", "pep_d_med": "1.0", "pos_frac_read_moore": "0.86"},
+            {"pep_frac_read_moore": "0.88", "pep_d_med": "1.0", "pos_frac_read_moore": "0.84"},
+        ])
+        result = read_p1c_csv(str(fp))
+        assert "error" not in result
+        # Only 2 valid rows for pep_frac_read_moore
+        assert result["pooled"]["pep_frac_read_moore"]["n"] == 2
+
+    def test_all_nan_fails_loud(self, tmp_path):
+        fp = tmp_path / "s207.csv"
+        _write_synthetic_csv(fp, [
+            {"pep_frac_read_moore": "", "pep_d_med": "", "pos_frac_read_moore": ""},
+        ])
+        result = read_p1c_csv(str(fp))
+        assert "error" in result
+
+
+# ---------------------------------------------------------------------------
+# ③ check_pool_margin
+# ---------------------------------------------------------------------------
+
+class TestPoolMargin:
+    def test_h1_pass_large_margin(self):
+        # pool=0.90, boundary=0.80, sd=0.02 → margin=0.10 >= 0.04 → PASS
+        ok, _ = check_pool_margin(0.90, 0.80, 0.02)
+        assert ok
+
+    def test_h1_fail_small_margin(self):
+        # pool=0.82, boundary=0.80, sd=0.02 → margin=0.02 < 0.04 → FAIL
+        ok, _ = check_pool_margin(0.82, 0.80, 0.02)
+        assert not ok
+
+    def test_h2_pass(self):
+        # pool=0.30, boundary=0.50, sd=0.05 → margin=0.20 >= 0.10 → PASS
+        ok, _ = check_pool_margin(0.30, 0.50, 0.05)
+        assert ok
+
+    def test_boundary_is_zero_sd(self):
+        # SD=0 → required=0 → always passes
+        ok, _ = check_pool_margin(0.85, 0.80, 0.0)
+        assert ok
+
+
+# ---------------------------------------------------------------------------
+# ④ check_consensus
+# ---------------------------------------------------------------------------
+
+class TestConsensus:
+    def test_3_of_4_h1_pass(self):
+        ok, msg = check_consensus(["H1", "H1", "H1", None])
+        assert ok
+        assert "H1" in msg
+
+    def test_2_of_4_fail(self):
+        ok, _ = check_consensus(["H1", "H1", "H2", None])
+        assert not ok
+
+    def test_all_none_fail(self):
+        ok, _ = check_consensus([None, None, None, None])
+        assert not ok
+
+    def test_conflict_2_2_fail(self):
+        ok, _ = check_consensus(["H1", "H1", "H2", "H2"])
+        assert not ok
+
+
+# ---------------------------------------------------------------------------
+# ⑤ compute_snr — §3.3.3
+# ---------------------------------------------------------------------------
+
+class TestComputeSnr:
+    def test_formula(self):
+        # SNR = (0.862 - pool) / SD
+        pool, sd = 0.40, 0.10
+        snr = compute_snr(pool, sd)
+        assert snr == pytest.approx((P1C_BASELINE - pool) / sd, abs=1e-9)
+
+    def test_sd_zero_returns_inf(self):
+        snr = compute_snr(0.40, 0.0)
+        assert snr == float("inf")
+
+    def test_baseline_is_0862(self):
+        assert P1C_BASELINE == 0.862
+
+
+# ---------------------------------------------------------------------------
+# ⑥ P1/P2 同向锁（§3.1）
+# ---------------------------------------------------------------------------
+
+class TestP1P2Conflict:
+    def test_conflict_seed_verdict_is_conflict(self, tmp_path):
+        # P1 says H1 (0.90), P2 says H2 (d_med=4.0) → 判据内冲突
+        rows = [
+            {"pep_frac_read_moore": "0.90", "pep_d_med": "4.0", "pos_frac_read_moore": "0.86"},
+        ]
+        data_dir = _write_seed_csvs(tmp_path, {s: rows for s in [207, 208, 209, 210]})
+        seeds = load_all_seeds(str(data_dir))
+        result = judge_tier1(seeds)
+        # All 4 seeds should be 判据内冲突
+        for seed_data in result["seeds"].values():
+            assert seed_data.get("seed_verdict") == "判据内冲突"
+
+
+# ---------------------------------------------------------------------------
+# ⑦ 全流程
+# ---------------------------------------------------------------------------
+
+class TestJudgeTier1Full:
+    def _make_h1_rows(self, pep_val, d_val, pos_val):
+        rows = []
+        for tick in [100, 200, 300]:
+            rows.append({
+                "tick": str(tick),
+                "pep_frac_read_moore": str(pep_val),
+                "pep_d_med": str(d_val),
+                "pos_frac_read_moore": str(pos_val),
+            })
+        return rows
+
+    def test_all_h1_clear(self, tmp_path):
+        rows = self._make_h1_rows(0.90, 1.0, 0.86)
+        data_dir = _write_seed_csvs(tmp_path, {s: rows for s in [207, 208, 209, 210]})
+        seeds = load_all_seeds(str(data_dir))
+        result = judge_tier1(seeds)
+        assert result["final_verdict"] == "H1"
+
+    def test_3_of_4_h1_pass(self, tmp_path):
+        h1_rows = self._make_h1_rows(0.90, 1.0, 0.86)
+        # seed 210: gray zone for P1 → excluded from consensus
+        gray_rows = self._make_h1_rows(0.65, 2.5, 0.86)
+        data_dir = _write_seed_csvs(tmp_path, {
+            207: h1_rows, 208: h1_rows, 209: h1_rows, 210: gray_rows,
+        })
+        result = judge_tier1(load_all_seeds(str(data_dir)))
+        assert result["consensus"]["ok"]
+        assert "H1" in result["final_verdict"]
+
+    def test_consensus_fail(self, tmp_path):
+        # 2 seeds H1, 2 seeds H2
+        h1_rows = self._make_h1_rows(0.90, 1.0, 0.86)
+        h2_rows = self._make_h1_rows(0.40, 4.0, 0.86)
+        data_dir = _write_seed_csvs(tmp_path, {
+            207: h1_rows, 208: h1_rows, 209: h2_rows, 210: h2_rows,
+        })
+        result = judge_tier1(load_all_seeds(str(data_dir)))
+        assert not result["consensus"]["ok"]
+        assert "不定" in result["final_verdict"]
+
+    def test_h2_snr_check_uses_correct_formula(self, tmp_path):
+        # Pool pep ≈ 0.40, seed SD ≈ 0.05 → SNR = (0.862-0.40)/0.05 = 9.24 >> 2
+        h2_rows = [
+            {"tick": str(t), "pep_frac_read_moore": "0.40",
+             "pep_d_med": "4.0", "pos_frac_read_moore": "0.86"}
+            for t in [100, 200, 300]
+        ]
+        data_dir = _write_seed_csvs(tmp_path, {s: h2_rows for s in [207, 208, 209, 210]})
+        result = judge_tier1(load_all_seeds(str(data_dir)))
+        assert result["final_verdict"].startswith("H2")
+        assert "SNR" in result["final_verdict"]
+
+    def test_missing_seed_reports_fail_loud(self, tmp_path):
+        rows = self._make_h1_rows(0.90, 1.0, 0.86)
+        data_dir = _write_seed_csvs(tmp_path, {207: rows, 208: rows})
+        # 209/210 not written → missing file
+        result = judge_tier1(load_all_seeds(str(data_dir)))
+        fail_notes = [n for n in result["notes"] if "FAIL" in n]
+        assert len(fail_notes) == 2
+        for n in fail_notes:
+            assert "209" in n or "210" in n
