-"""Tier-1 擦除集判读（P1-c 根因判别）—— 读 summary.json，按 R363 已锁判据出附表 + 结论。
-
-用法::
-
-    python experiments/tier1_readout.py [--data-dir PATH] [--out PATH]
-
-判据来源：``docs/设计文档/设计-R358-T1-根因判别-H1H2-20261003.md`` §三（天平 R363 锁定）。
-数据落点：``the-world-data/p1c_erase/*.summary.json``（4 seed）。
-
-退出码：0=H1, 1=H2, 2=不定, 3=数据不足。
-"""
-
-import argparse
-import json
-import math
-import sys
-from collections import Counter
-from pathlib import Path
-from typing import Dict, List, Optional, Tuple
-
-THRESHOLDS = {
-    "pep_frac_read_moore": {"H1": 0.80, "H2": 0.50},
-    "pep_d_med":            {"H1": 2.0,  "H2": 3.0},
-    "delta_R":              {"H1": 0.05, "H2": 0.25},
-    "consensus_min":        3,
-    "consensus_total":      4,
-    "pool_margin_sd":       2.0,
-    "h2_snr_min":           2.0,
-    "p1c_baseline":         0.862,
-}
-
-SEEDS = [207, 208, 209, 210]
-
-
-def classify_band(value: float, metric: str) -> str:
-    """单值判带：H1 / gray / H2。
-
-    pep_frac_read_moore: ≥0.80→H1, ≤0.50→H2
-    pep_d_med:           ≤2.0→H1, ≥3.0→H2
-    delta_R:             ≤0.05→H1, ≥0.25→H2
-    """
-    th = THRESHOLDS[metric]
-    if metric in ("pep_d_med", "delta_R"):
-        if value <= th["H1"]:
-            return "H1"
-        if value >= th["H2"]:
-            return "H2"
-    else:
-        if value >= th["H1"]:
-            return "H1"
-        if value <= th["H2"]:
-            return "H2"
-    return "gray"
-
-
-def _stdev(values: List[float]) -> float:
-    n = len(values)
-    if n < 2:
-        return 0.0
-    mu = sum(values) / n
-    return math.sqrt(sum((x - mu) ** 2 for x in values) / (n - 1))
-
-
-def load_seed(data_dir: Path, seed: int) -> Optional[Dict]:
-    """读单个 summary.json，提取判据所需字段。"""
-    fp = data_dir / f"p1c_erase_s{seed}_t3000.summary.json"
-    if not fp.exists():
-        return None
-    with fp.open(encoding="utf-8") as f:
-        d = json.load(f)
-    p = d["pooled"]
-    return {
-        "seed": seed,
-        "pep_frac_read_moore": p["pep"]["frac_read_moore"],
-        "pep_d_med": p["pep"]["d_med"],
-        "pos_frac_read_moore": p["pos_frac_read_moore"],
-        "delta_R": p["pos_frac_read_moore"] - p["pep"]["frac_read_moore"],
-        "pep64_frac_read_moore": p["pep64"]["frac_read_moore"],
-        "n_samples": p["n_samples"],
-    }
-
-
-def load_all_seeds(data_dir: Path) -> Dict[int, Dict]:
-    result = {}
-    for seed in SEEDS:
-        s = load_seed(data_dir, seed)
-        if s is not None:
-            result[seed] = s
-    return result
-
-
-def check_consensus(bands: List[str]) -> Tuple[bool, Optional[str], str]:
-    """≥3/4 同带 ⇒ True。gray 不参与同带计数。"""
-    cnt = Counter(b for b in bands if b != "gray")
-    if not cnt:
-        return False, None, "全部灰区"
-    top_band, top_n = cnt.most_common(1)[0]
-    total = THRESHOLDS["consensus_total"]
-    ok = top_n >= THRESHOLDS["consensus_min"]
-    return ok, top_band if ok else None, f"{top_n}/{total} {top_band}"
-
-
-def check_pool_margin(pool_val: float, sd: float, metric: str) -> Tuple[bool, str]:
-    """池化值离最近带界 ≥ 2×SD。"""
-    band = classify_band(pool_val, metric)
-    th = THRESHOLDS[metric]
-    if band == "H1":
-        if metric in ("pep_d_med", "delta_R"):
-            boundary = th["H1"]
-            margin = boundary - pool_val
-        else:
-            boundary = th["H1"]
-            margin = pool_val - boundary
-    elif band == "H2":
-        if metric in ("pep_d_med", "delta_R"):
-            boundary = th["H2"]
-            margin = pool_val - boundary
-        else:
-            boundary = th["H2"]
-            margin = boundary - pool_val
-    else:
-        return False, f"池化值 {pool_val:.4f} 在灰区，离界检查不适用"
-    required = THRESHOLDS["pool_margin_sd"] * sd
-    ok = margin >= required
-    return ok, f"|{pool_val:.4f} - {boundary}| = {margin:.4f} {'>=' if ok else '<'} {required:.4f} (2xSD={sd:.4f})"
-
-
-def judge(data_dir: Path) -> Dict:
-    """主判读流程，返回结构化结果。"""
-    seeds = load_all_seeds(data_dir)
-    metrics = ["pep_frac_read_moore", "pep_d_med", "delta_R"]
-    result: Dict = {
-        "seeds": seeds,
-        "n_loaded": len(seeds),
-        "metrics": {},
-        "k64": {},
-        "notes": [],
-        "final_verdict": None,
-    }
-
-    if len(seeds) < 2:
-        result["final_verdict"] = "不定（数据不足）"
-        return result
-
-    for metric in metrics:
-        per_seed = {s: d[metric] for s, d in seeds.items()}
-        vals = list(per_seed.values())
-        pool = sum(vals) / len(vals)
-        sd = _stdev(vals)
-        bands = [classify_band(v, metric) for v in vals]
-        con_ok, con_band, con_msg = check_consensus(bands)
-        margin_ok, margin_msg = check_pool_margin(pool, sd, metric)
-        result["metrics"][metric] = {
-            "per_seed": per_seed,
-            "pool_mean": pool,
-            "sd": sd,
-            "bands": dict(zip(seeds.keys(), bands)),
-            "consensus_ok": con_ok,
-            "consensus_band": con_band,
-            "consensus_msg": con_msg,
-            "margin_ok": margin_ok,
-            "margin_msg": margin_msg,
-        }
-
-    k64_vals = {s: d["pep64_frac_read_moore"] for s, d in seeds.items()}
-    k64_pool = sum(k64_vals.values()) / len(k64_vals)
-    k64_sd = _stdev(list(k64_vals.values()))
-    k64_bands = [classify_band(v, "pep_frac_read_moore") for v in k64_vals.values()]
-    k64_con_ok, k64_con_band, k64_con_msg = check_consensus(k64_bands)
-    result["k64"] = {
-        "per_seed": k64_vals,
-        "pool_mean": k64_pool,
-        "sd": k64_sd,
-        "bands": dict(zip(seeds.keys(), k64_bands)),
-        "consensus_ok": k64_con_ok,
-        "consensus_band": k64_con_band,
-        "consensus_msg": k64_con_msg,
-    }
-
-    primary_bands = [result["metrics"][m]["consensus_band"] for m in metrics]
-    all_consensus = all(result["metrics"][m]["consensus_ok"] for m in metrics)
-    all_margin = all(result["metrics"][m]["margin_ok"] for m in metrics)
-    non_gray = [b for b in primary_bands if b is not None]
-    primary_agree = len(set(non_gray)) <= 1 and len(non_gray) == len(primary_bands)
-
-    if not all_consensus:
-        failed = [m for m in metrics if not result["metrics"][m]["consensus_ok"]]
-        result["final_verdict"] = "不定（一致性锁不满足）"
-        result["notes"].append(f"一致性锁失败: {', '.join(failed)}")
-    elif not primary_agree:
-        result["final_verdict"] = "不定（主判据间方向冲突）"
-        result["notes"].append(f"主判据方向: {primary_bands}")
-    else:
-        verdict = non_gray[0]
-        if not all_margin:
-            failed = [m for m in metrics if not result["metrics"][m]["margin_ok"]]
-            result["final_verdict"] = f"{verdict}（离界余量不足，弱信号）"
-            result["notes"].append(f"离界余量不足: {', '.join(failed)}")
-        elif verdict == "H2":
-            pep_pool = result["metrics"]["pep_frac_read_moore"]["pool_mean"]
-            pep_sd = result["metrics"]["pep_frac_read_moore"]["sd"]
-            snr = (THRESHOLDS["p1c_baseline"] - pep_pool) / pep_sd if pep_sd > 0 else float("inf")
-            if snr < THRESHOLDS["h2_snr_min"]:
-                result["final_verdict"] = f"不定（H2 但 SNR={snr:.2f}<2）"
-                result["notes"].append(f"SNR = {snr:.2f} < {THRESHOLDS['h2_snr_min']}")
-            else:
-                result["final_verdict"] = f"H2(SNR={snr:.2f}>=2)"
-        else:
-            result["final_verdict"] = verdict
-
-    return result
-
-
-def format_markdown(r: Dict) -> str:
-    seeds = r["seeds"]
-    seed_ids = sorted(seeds.keys())
-    lines = [
-        "# Tier-1 擦除集判读附表（P1-c 根因判别）",
-        "",
-        "> 判据来源：`docs/设计文档/设计-R358-T1-根因判别-H1H2-20261003.md` §三（天平 R363 锁定）",
-        "> 数据：`the-world-data/p1c_erase/*.summary.json`",
-        "",
-        "## 附表 1：逐 seed 主判据",
-        "",
-        "| seed | `pep_frac_read_moore` | band | `pep_d_med` | band | dR (pos-pep) | band |",
-        "|---:|---:|:---:|---:|:---:|---:|:---:|",
-    ]
-    for s in seed_ids:
-        d = seeds[s]
-        lines.append(
-            f"| {s} "
-            f"| {d['pep_frac_read_moore']:.4f} | {classify_band(d['pep_frac_read_moore'], 'pep_frac_read_moore')} "
-            f"| {d['pep_d_med']:.4f} | {classify_band(d['pep_d_med'], 'pep_d_med')} "
-            f"| {d['delta_R']:.4f} | {classify_band(d['delta_R'], 'delta_R')} |"
-        )
-
-    lines += ["", "## 附表 2：池化统计与一致性锁", ""]
-    lines.append("| 指标 | 池化均值 | seed-SD | 一致 | 离界 |")
-    lines.append("|---|---:|---:|:---:|---|")
-    for metric in ["pep_frac_read_moore", "pep_d_med", "delta_R"]:
-        m = r["metrics"][metric]
-        con = "PASS" if m["consensus_ok"] else "FAIL"
-        lines.append(
-            f"| `{metric}` | {m['pool_mean']:.4f} | {m['sd']:.4f} "
-            f"| {con} ({m['consensus_msg']}) | {m['margin_msg']} |"
-        )
-
-    k = r["k64"]
-    lines += [
-        "",
-        "## 附表 3：K64 次判列",
-        "",
-        "| seed | `pep64_frac_read_moore` | band |",
-        "|---:|---:|:---:|",
-    ]
-    for s in seed_ids:
-        v = k["per_seed"][s]
-        lines.append(f"| {s} | {v:.4f} | {classify_band(v, 'pep_frac_read_moore')} |")
-    lines.append(f"| **pool** | **{k['pool_mean']:.4f}** | — |")
-
-    lines += [
-        "",
-        "---",
-        "",
-        f"**结论：{r['final_verdict']}**",
-        "",
-    ]
-    if r["notes"]:
-        for n in r["notes"]:
