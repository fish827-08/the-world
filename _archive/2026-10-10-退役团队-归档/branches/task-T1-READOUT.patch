+def read_seed_summary(data_dir: str, seed: int) -> Dict:
+    """读单个 seed 的 summary.json，返回 pooled 加权值（镜 R371 令）。
+
+    数据源：summary.json.pooled.{pep, pos_frac_read_moore}（加权，非 CSV 等权）。
+    缺文件/缺字段/NaN ⇒ 返回 {"error": ..., "missing_cols": [...]} 并 fail-loud。
+    """
+    fp = Path(data_dir) / f"p1c_erase_s{seed}_t3000.summary.json"
+    if not fp.exists():
+        return {"error": f"summary.json 不存在: {fp}", "missing_cols": []}
+
+    with fp.open(encoding="utf-8") as f:
+        d = json.load(f)
+
+    try:
+        pooled = d["pooled"]
+        pep = pooled["pep"]
+        pep_frac = float(pep["frac_read_moore"])
+        pep_d_med = float(pep["d_med"])
+        pos_frac = float(pooled["pos_frac_read_moore"])
+    except (KeyError, TypeError, ValueError) as e:
+        return {"error": f"summary.json 字段缺失或类型错误: {e}", "missing_cols": [str(e)]}
+
+    missing = []
+    for name, val in [("pep.frac_read_moore", pep_frac),
+                      ("pep.d_med", pep_d_med),
+                      ("pos_frac_read_moore", pos_frac)]:
+        if math.isnan(val):
+            missing.append(name)
+    if missing:
+        return {"error": f"summary.pooled 含 NaN: {missing}", "missing_cols": missing}
+
+    delta_r = pos_frac - pep_frac
+    return {
+        "file": str(fp),
+        "seed": seed,
+        "pooled": {
+            "pep_frac_read_moore": {"mean": pep_frac, "median": pep_frac, "stdev": 0.0, "n": 1},
+            "pep_d_med":           {"mean": pep_d_med, "median": pep_d_med, "stdev": 0.0, "n": 1},
+            "delta_R":             {"mean": delta_r,   "median": delta_r,   "stdev": 0.0, "n": 1},
+        },
+    }
+
