+"""Tier-1 readout 靶向测试——合成 summary.json 钉判据边界。
+
+覆盖：
+  ① classify_band 各指标边界（H1/H2/灰区）
+  ② 一致性锁（≥3/4 同带 PASS、<3 FAIL）
+  ③ 池化离界余量（≥2×SD PASS、<2×SD FAIL）
+  ④ H2 SNR 门（≥2 PASS、<2 FAIL）
+  ⑤ 全流程端到端（合成数据 → H1 判定）
+  ⑥ 全流程端到端（合成数据 → H2 判定 + SNR 检查）
+  ⑦ K64 次判列
+"""
+
+import json
+import math
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from experiments.tier1_readout import (
+    THRESHOLDS,
+    check_consensus,
+    check_pool_margin,
+    classify_band,
+    format_markdown,
+    judge,
+)
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+
+def _make_summary(
+    seed: int,
+    pep_frac_read_moore: float = 0.90,
+    pep_d_med: float = 1.0,
+    pos_frac_read_moore: float = 0.86,
+    pep64_frac_read_moore: float = 0.82,
+    n_samples: int = 30,
+) -> dict:
+    return {
+        "probe": "p1c_erasure_probe",
+        "seed": seed,
+        "ticks": 3000,
+        "pooled": {
+            "n_samples": n_samples,
+            "pos_frac_read_moore": pos_frac_read_moore,
+            "pep": {
+                "frac_read_moore": pep_frac_read_moore,
+                "d_med": pep_d_med,
+            },
+            "pep64": {
+                "frac_read_moore": pep64_frac_read_moore,
+            },
+        },
+    }
+
+
+def _write_seeds(tmp_path: Path, seeds: dict) -> Path:
+    """写合成 summary.json 到 tmp_path，返回 data_dir。"""
+    data_dir = tmp_path / "data"
+    data_dir.mkdir()
+    for seed, kwargs in seeds.items():
+        obj = _make_summary(seed=seed, **kwargs)
+        fp = data_dir / f"p1c_erase_s{seed}_t3000.summary.json"
+        fp.write_text(json.dumps(obj), encoding="utf-8")
+    return data_dir
+
+
+# ---------------------------------------------------------------------------
+# ① classify_band 边界
+# ---------------------------------------------------------------------------
+
+class TestClassifyBand:
+    # pep_frac_read_moore: ≥0.80→H1, ≤0.50→H2, else gray
+    def test_pep_frac_read_moore_h1_boundary(self):
+        assert classify_band(0.80, "pep_frac_read_moore") == "H1"
+        assert classify_band(0.90, "pep_frac_read_moore") == "H1"
+
+    def test_pep_frac_read_moore_h2_boundary(self):
+        assert classify_band(0.50, "pep_frac_read_moore") == "H2"
+        assert classify_band(0.30, "pep_frac_read_moore") == "H2"
+
+    def test_pep_frac_read_moore_gray(self):
+        assert classify_band(0.65, "pep_frac_read_moore") == "gray"
+        assert classify_band(0.799, "pep_frac_read_moore") == "gray"
+
+    # pep_d_med: ≤2.0→H1, ≥3.0→H2, else gray
+    def test_pep_d_med_h1_boundary(self):
+        assert classify_band(2.0, "pep_d_med") == "H1"
+        assert classify_band(1.0, "pep_d_med") == "H1"
+
+    def test_pep_d_med_h2_boundary(self):
+        assert classify_band(3.0, "pep_d_med") == "H2"
+        assert classify_band(5.0, "pep_d_med") == "H2"
+
+    def test_pep_d_med_gray(self):
+        assert classify_band(2.5, "pep_d_med") == "gray"
+
+    # delta_R: ≤0.05→H1, ≥0.25→H2, else gray
+    def test_delta_r_h1_boundary(self):
+        assert classify_band(0.05, "delta_R") == "H1"
+        assert classify_band(-0.03, "delta_R") == "H1"
+        assert classify_band(0.0, "delta_R") == "H1"
+
+    def test_delta_r_h2_boundary(self):
+        assert classify_band(0.25, "delta_R") == "H2"
+        assert classify_band(0.50, "delta_R") == "H2"
+
+    def test_delta_r_gray(self):
+        assert classify_band(0.15, "delta_R") == "gray"
+
+
+# ---------------------------------------------------------------------------
+# ② 一致性锁
+# ---------------------------------------------------------------------------
+
+class TestConsensus:
+    def test_3_of_4_pass(self):
+        ok, band, msg = check_consensus(["H1", "H1", "H1", "H2"])
+        assert ok
+        assert band == "H1"
+
+    def test_4_of_4_pass(self):
+        ok, band, msg = check_consensus(["H1", "H1", "H1", "H1"])
+        assert ok
+        assert band == "H1"
+
+    def test_2_of_4_fail(self):
+        ok, band, msg = check_consensus(["H1", "H1", "H2", "H2"])
+        assert not ok
+        assert band is None
+
+    def test_gray_excluded(self):
+        ok, band, msg = check_consensus(["H1", "H1", "H1", "gray"])
+        assert ok
+        assert band == "H1"
+
+    def test_all_gray(self):
+        ok, band, msg = check_consensus(["gray", "gray", "gray", "gray"])
+        assert not ok
+
+
+# ---------------------------------------------------------------------------
+# ③ 池化离界余量
+# ---------------------------------------------------------------------------
+
+class TestPoolMargin:
+    def test_h1_pass_large_margin(self):
+        ok, msg = check_pool_margin(0.90, 0.02, "pep_frac_read_moore")
+        assert ok
+
+    def test_h1_fail_small_margin(self):
+        ok, msg = check_pool_margin(0.82, 0.02, "pep_frac_read_moore")
+        assert not ok
+
+    def test_h2_pass(self):
+        ok, msg = check_pool_margin(0.30, 0.05, "pep_frac_read_moore")
+        assert ok
+
+    def test_gray_fail(self):
+        ok, msg = check_pool_margin(0.65, 0.01, "pep_frac_read_moore")
+        assert not ok
+
+    def test_d_med_h1_pass(self):
+        ok, msg = check_pool_margin(1.0, 0.3, "pep_d_med")
+        assert ok
+
+    def test_delta_r_h1_pass(self):
+        ok, msg = check_pool_margin(-0.03, 0.005, "delta_R")
+        assert ok
+
+
+# ---------------------------------------------------------------------------
+# ④ 全流程 → H1
+# ---------------------------------------------------------------------------
+
+class TestJudgeH1:
+    def test_all_h1_clear(self, tmp_path):
+        data_dir = _write_seeds(tmp_path, {
+            207: {"pep_frac_read_moore": 0.90, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.86, "pep64_frac_read_moore": 0.82},
+            208: {"pep_frac_read_moore": 0.91, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.87, "pep64_frac_read_moore": 0.83},
+            209: {"pep_frac_read_moore": 0.89, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.85, "pep64_frac_read_moore": 0.81},
+            210: {"pep_frac_read_moore": 0.90, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.86, "pep64_frac_read_moore": 0.82},
+        })
+        r = judge(data_dir)
+        assert r["final_verdict"].startswith("H1")
+        md = format_markdown(r)
+        assert "结论" in md
+        assert "H1" in md
+
+    def test_3_of_4_h1_pass(self, tmp_path):
+        data_dir = _write_seeds(tmp_path, {
+            207: {"pep_frac_read_moore": 0.90, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.86},
+            208: {"pep_frac_read_moore": 0.91, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.87},
+            209: {"pep_frac_read_moore": 0.89, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.85},
+            210: {"pep_frac_read_moore": 0.65, "pep_d_med": 2.5,
+                   "pos_frac_read_moore": 0.80},
+        })
+        r = judge(data_dir)
+        assert "H1" in r["final_verdict"]
+
+
+# ---------------------------------------------------------------------------
+# ⑤ 全流程 → H2（需 SNR≥2）
+# ---------------------------------------------------------------------------
+
+class TestJudgeH2:
+    def test_h2_with_snr_pass(self, tmp_path):
+        vals = [0.40, 0.42, 0.38, 0.41]
+        data_dir = _write_seeds(tmp_path, {
+            s: {"pep_frac_read_moore": v, "pep_d_med": 4.0,
+                 "pos_frac_read_moore": 0.86, "pep64_frac_read_moore": 0.40}
+            for s, v in zip([207, 208, 209, 210], vals)
+        })
+        r = judge(data_dir)
+        assert r["final_verdict"].startswith("H2")
+
+    def test_h2_snr_fail(self):
+        # 数学上 margin 通过 + SNR<2 在 baseline=0.862 时不可达（H2≤0.50 约束），
+        # 直接验证 SNR 计算逻辑：SNR = (baseline - pool) / SD
+        pool, sd, baseline = 0.40, 0.25, 0.862
+        snr = (baseline - pool) / sd
+        assert snr == pytest.approx(1.848, abs=0.01)
+        assert snr < THRESHOLDS["h2_snr_min"]
+
+
+# ---------------------------------------------------------------------------
+# ⑥ 一致性锁失败 → 不定
+# ---------------------------------------------------------------------------
+
+class TestJudgeIndecisive:
+    def test_consensus_fail(self, tmp_path):
+        data_dir = _write_seeds(tmp_path, {
+            207: {"pep_frac_read_moore": 0.90, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.86},
+            208: {"pep_frac_read_moore": 0.91, "pep_d_med": 1.0,
+                   "pos_frac_read_moore": 0.87},
+            209: {"pep_frac_read_moore": 0.40, "pep_d_med": 4.0,
+                   "pos_frac_read_moore": 0.80},
+            210: {"pep_frac_read_moore": 0.38, "pep_d_med": 4.0,
+                   "pos_frac_read_moore": 0.78},
+        })
+        r = judge(data_dir)
+        assert "不定" in r["final_verdict"]
+
+
+# ---------------------------------------------------------------------------
+# ⑦ K64 次判列
+# ---------------------------------------------------------------------------
+
+class TestK64:
+    def test_k64_recorded(self, tmp_path):
+        data_dir = _write_seeds(tmp_path, {
+            207: {"pep64_frac_read_moore": 0.82},
+            208: {"pep64_frac_read_moore": 0.83},
+            209: {"pep64_frac_read_moore": 0.81},
+            210: {"pep64_frac_read_moore": 0.82},
+        })
+        r = judge(data_dir)
+        assert r["k64"]["pool_mean"] == pytest.approx(0.82, abs=0.01)
+        assert all(b == "H1" for b in r["k64"]["bands"].values())
+
+    def test_k64_in_markdown(self, tmp_path):
+        data_dir = _write_seeds(tmp_path, {
+            s: {"pep64_frac_read_moore": 0.82} for s in [207, 208, 209, 210]
+        })
+        r = judge(data_dir)
+        md = format_markdown(r)
+        assert "K64" in md
+        assert "pep64_frac_read_moore" in md
+
+
+# ---------------------------------------------------------------------------
+# ⑧ delta_R 计算正确性
+# ---------------------------------------------------------------------------
+
+class TestDeltaR:
+    def test_delta_r_computed_correctly(self, tmp_path):
+        data_dir = _write_seeds(tmp_path, {
+            207: {"pep_frac_read_moore": 0.90, "pos_frac_read_moore": 0.86},
+            208: {"pep_frac_read_moore": 0.88, "pos_frac_read_moore": 0.84},
+            209: {"pep_frac_read_moore": 0.92, "pos_frac_read_moore": 0.88},
+            210: {"pep_frac_read_moore": 0.90, "pos_frac_read_moore": 0.86},
+        })
+        r = judge(data_dir)
+        assert r["seeds"][207]["delta_R"] == pytest.approx(-0.04, abs=1e-9)
+        assert r["seeds"][208]["delta_R"] == pytest.approx(-0.04, abs=1e-9)
