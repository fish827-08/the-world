+"""L3-G5COL：g5_dircond_diff（条件方向 TV，R367-1 锁定口径）靶向测试。
+
+口径（docs/C1-M0仪表产出规格-20261003.md §七）：
+  仅有位移个体（move_dir ≠ 静止）上，有/无信号两组 8 向 argmax 序号
+  归一化直方图的 TV = 0.5·Σ|p_sig − p_nosig|；任一有位移组空 ⇒ NaN。
+
+覆盖：
+  ① 已知两组位移分布 ⇒ 钉 TV 值（含静止个体干扰项，dir_diff/dircond_diff 分离）
+  ② 两组位移方向完全相同 ⇒ 0.0（且 dir_diff 仍可为正 ⇒ 证互补）
+  ③ 任一有位移组空（全静止/单组动）⇒ NaN fail-loud（不静默给 0）
+  ④ 变异检查 A：把静止槽(4)误并入直方图 ⇒ 该测试必须变红
+  ⑤ 变异检查 B：无位移过滤（全量两组）⇒ 该测试必须变红
+  ⑥ M0_COLS 含新列且默认关时表头不变（逐字节等价锁）
+"""
+
+import sys
+import types
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from experiments.s3_memory_probe import _M0_COLS, _M0Instruments
+
+ROWS, COLS = 24, 12
+N_CELLS = ROWS * COLS
+
+
+def _mk_engine(ids, dec_flat, now_flat, marks_hit_cells):
+    """合成假引擎：ids 升序；dec_flat=决策时点格（上步末）；now_flat=本步末格。
+
+    marks_hit_cells：这些格 _marks>0 ⇒ 决策时点"有信号"组（hs=True）。
+    """
+    eng = types.SimpleNamespace()
+    eng._id = np.asarray(ids, dtype=np.int64)
+    eng._flat = np.asarray(now_flat, dtype=np.int64)
+    eng.world = types.SimpleNamespace(
+        cols=COLS, rows=ROWS, _pole_top=0, _pole_bottom=ROWS - 1)
+    nb = np.zeros((N_CELLS, 8), dtype=np.int64)
+    nb[:] = np.arange(N_CELLS)[:, None]          # 自指即可：只要 _marks 全 0 除命中格
+    eng._nb_table = nb
+    eng._pole_nb = np.zeros((2, 8), dtype=np.int64)
+    marks = np.zeros(N_CELLS, dtype=np.uint8)
+    for c in marks_hit_cells:
+        marks[c] = 5                              # 任意 >0 pattern
+    eng.signals = types.SimpleNamespace(_marks=marks)
+    return eng
+
+
+def _mk_inst(ids, dec_flat):
+    inst = _M0Instruments()
+    inst.last_ids = np.asarray(ids, dtype=np.int64)
+    inst.last_flat = np.asarray(dec_flat, dtype=np.int64)
+    return inst
+
+
+# 8 向 code：code = (dr+1)*3 + sign(dc) + 1，静止=4
+#   dr=-1 行上移(-)；dc 环向。 dir 右= (0,+1)→code 5；左=4-? 推算：
+#   (dr=0,dc=+1): (1)*3+1+1=5; (dr=0,dc=-1): 3+(-1)+1=3; (dr=-1,dc=0): 0+0+1=1;
+#   (dr=+1,dc=0): 6+0+1=7。
+
+RIGHT = (0, +1)
+LEFT = (0, -1)
+UP = (-1, 0)
+STAY = None
+
+
+def _flat_at(row, col):
+    return row * COLS + col
+
+
+def _moved(dec, direction):
+    if direction is STAY:
+        return dec
+    dr, dc = direction
+    row, col = divmod(dec, COLS)
+    return _flat_at((row + dr) % ROWS, (col + dc) % COLS)
+
+
+def test_dircond_known_tv():
+    """sig 组：全向右(5)；nosig 动组：向上(7)+向左(3)；nosig 组含 1 静止个体。
+
+    条件分布：p_sig=one-hot(5)；p_no={7:0.5, 3:0.5} ⇒ dircond TV = 1.0（支撑不重叠）。
+    """
+    ids = [10, 11, 12, 13, 14]
+    dec = [_flat_at(5, 3), _flat_at(5, 6), _flat_at(8, 2),
+           _flat_at(8, 8), _flat_at(12, 4)]
+    sig_cells = {dec[0], dec[1]}                  # 个体 0/1 决策点有信号
+    now = [_moved(dec[0], RIGHT), _moved(dec[1], RIGHT),
+           _moved(dec[2], UP),
+           _moved(dec[3], LEFT),
+           dec[4]]                                 # 个体 4 无信号且静止
+    eng = _mk_engine(ids, dec, now, sig_cells)
+    inst = _mk_inst(ids, dec)
+    out = inst._compute_g5(eng)
+    # 动组：sig={5:2} ⇒ one-hot 5；no={7:1, 3:1}
+    # dircond TV = 0.5*(1 + 0.5 + 0.5) = 1.0
+    assert out["g5_dircond_diff"] == pytest.approx(1.0)
+    # 全量 9 档：p_sig=one-hot5；p_no={3:0.5, 7:0.5, 4:0}…个体 4 静止 ⇒
+    # p_no={3:1/3, 7:1/3, 4:1/3}；TV = 0.5*(1 + 1/3 + 1/3 + 1/3) = 1.0（支撑不重叠恒 1）
+    assert out["g5_dir_diff"] == pytest.approx(1.0)
+    assert out["g5_move_diff"] == pytest.approx(1.0 / 3)
+
+
+def test_dircond_dilution_known_value():
+    """构造 Z：方向支撑有重叠 + 静止稀释 ⇒ dircond 与 dir_diff 取不同已知值。
+
+    sig 组：RIGHT, RIGHT, STAY；no 组：RIGHT, LEFT, LEFT, LEFT, STAY。
+    条件（剔静止）：p_sig={5:1}, p_no={5:0.25, 3:0.75} ⇒ TV = 0.5*(0.75+0.75) = 0.75
+    全量 9 档：    p_sig={5:2/3,4:1/3}, p_no={5:.2,3:.6,4:.2} ⇒ TV = 0.6
+    静止率差：    |P(静|no) − P(静|sig)| = |0.2 − 1/3| = 0.1333
+    """
+    ids = [80, 81, 82, 83, 84, 85, 86, 87]
+    dec = [_flat_at(5, c) for c in (1, 4, 7, 10)] + [_flat_at(9, c) for c in (1, 4, 7, 10)]
+    sig_cells = {dec[0], dec[1], dec[2]}
+    now = [_moved(dec[0], RIGHT), _moved(dec[1], RIGHT), dec[2],
+           _moved(dec[3], RIGHT), _moved(dec[4], LEFT), _moved(dec[5], LEFT),
+           _moved(dec[6], LEFT), dec[7]]
+    eng = _mk_engine(ids, dec, now, sig_cells)
+    inst = _mk_inst(ids, dec)
+    out = inst._compute_g5(eng)
+    assert out["g5_dircond_diff"] == pytest.approx(0.75)
+    assert out["g5_dir_diff"] == pytest.approx(0.6)
+    assert out["g5_move_diff"] == pytest.approx(abs(0.2 - 1 / 3), abs=1e-6)
+
+
+def test_dircond_nan_when_all_stationary_one_group():
+    """无信号组全静止 ⇒ 有位移子集单组空 ⇒ NaN（不许静默 0）。"""
