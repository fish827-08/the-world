+# -*- coding: utf-8 -*-
+"""E-057 rep_w 档扫读数器（砚，2026-10-06）——按双签锁定文本 §二/§三 出数。
+
+口径（锁定 @main 2306949 会签态；不得擅动）：
+- 窗：n=每 run 采样行数；F=前 k=int(0.25n) 窗；M=中段窗 floor(0.35n)..ceil(0.65n)（n=20 => 1基第8-13窗）；
+  L=后 k 窗；peak_gain=max(g15)-F；K1 形态 = peak_gain>=0.010 且 M>=F（只描述不判正）。
+- K2 主判据：档 vs **同树锚臂**（rep_w=0 且 solo）逐 seed 配对 D=(M-F)_档-(M-F)_锚；
+  D>0 计数；档判 >=4/5 seed 同向（计数/8>=0.8）。旁证 Dpeak_gain 同向计数（只报）。
+- E-056 跨树核验列：档与锚各自对 E-056 同 seed (M-F)（值内嵌=锁定 §三附）报偏离；偏离过大如实披露候裁。
+- K3 生态门：档内 存活>=5/8 且 P3（窗末 pop>=6945）逐 run；不过门档 K1/K2 标 NOT-EXECUTABLE。
+- 装置回显逐 run 核对：rd off / alphabet 8 / arms off / instruments on / emit-window-frac 0.25 /
+  reputation_weight_effective==档值 / info_structure_enabled_effective==True（solo 形制）。
+- NaN：g15_mean 出现 NaN => fail-loud 该 seed 判不定（K2 计缺）；观察列 NaN 披露。
+
+用法：py tools/e057_readout.py --data the-world-data/e057_batch [--pattern "e057*_s*_t2000.csv"]
+"""
+from __future__ import annotations
+import argparse, csv, glob, json, math, os, re, statistics
+
+E056_MF = {  # 锁定 §三附（跨树核验参照，e057_baseline_calc.py 可复现）
+    "207": 0.0215, "208": -0.0189, "209": 0.0194, "210": 0.0269,
+    "211": 0.0141, "212": 0.0050, "213": 0.0100, "214": 0.0030,
+}
+ARMS = [0.0, 0.05, 0.2, 0.5]
+P3_GATE = 6945.0
+DELTA_PK = 0.010
+
+
+def segs(vals):
+    n = len(vals)
+    k = int(0.25 * n)
+    a, b = math.floor(0.35 * n) + 1, math.ceil(0.65 * n)
+    F = statistics.mean(vals[:k])
+    M = statistics.mean(vals[a - 1:b])
+    L = statistics.mean(vals[-k:])
+    return F, M, L, max(vals)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data", default="the-world-data/e057_batch")
+    ap.add_argument("--pattern", default="*s*_t2000.csv")
+    a = ap.parse_args()
+    runs = {}
+    for fp in sorted(glob.glob(os.path.join(a.data, a.pattern))):
+        if fp.endswith(".summary.json"):
+            continue
+        m = re.search(r"_s(\d+)_t", os.path.basename(fp))
+        if not m:
+            continue
+        seed = m.group(1)
+        rows = list(csv.DictReader(open(fp, encoding="utf-8")))
+        summ_p = fp.replace(".csv", ".summary.json")
+        meta, run0 = {}, {}
+        if os.path.exists(summ_p):
+            j = json.load(open(summ_p, encoding="utf-8"))
+            meta, runs_list = j.get("meta", {}), j.get("runs", [])
+            run0 = runs_list[-1] if runs_list else {}
+        rw = run0.get("reputation_weight_effective", meta.get("reputation_weight"))
+        rw = 0.0 if rw is None else float(rw)
+        arm = min(ARMS, key=lambda x: abs(x - rw))
+        flag = []
+        vals = []
+        for r in rows:
+            v = r.get("g15_mean", "")
+            if v in ("", "nan", None):
+                flag.append(f"NaN@t{r.get('tick')}")
+                continue
+            vals.append(float(v))
+        echo = {
+            "rd": meta.get("rd_mode"), "alpha": str(meta.get("alphabet")),
+            "arms": meta.get("arms"), "inst": meta.get("m0_instruments"),
+            "wfrac": run0.get("emit_rate_window_frac", meta.get("m0_emit_window_frac")),
+            "rw_eff": run0.get("reputation_weight_effective"),
+            "is_en": run0.get("info_structure_enabled_effective"),
+        }
+        dev = []
+        if echo["rd"] not in (None, "off"): dev.append(f"rd={echo['rd']}")
+        if echo["alpha"] not in ("8", "None"): dev.append(f"alpha={echo['alpha']}")
+        if echo["arms"] not in (None, "off"): dev.append(f"arms={echo['arms']}")
+        if echo["inst"] is False: dev.append("inst=False")
+        if echo["wfrac"] not in (None, 0.25): dev.append(f"wfrac={echo['wfrac']}")
+        if echo["rw_eff"] is not None and abs(float(echo["rw_eff"]) - rw) > 1e-9:
+            dev.append(f"rw_eff={echo['rw_eff']}!=meta{rw}")
+        if echo["is_en"] is not None and echo["is_en"] is not True:
+            dev.append(f"is_en={echo['is_en']}")
+        pops = [float(r["pop"]) for r in rows]
+        stop = run0.get("stop", "?")
+        alive = stop != "灭绝" and (run0.get("extinct_at") is None) and pops[-1] > 0
+        F, M, L, P = segs(vals)
+        g5 = statistics.mean([float(r["g5_dir_diff"]) for r in rows if r.get("g5_dir_diff") not in ("", "nan", None)] or [float("nan")])
+        emit_ratio = run0.get("emit_rate_ratio", float("nan"))
+        zero = run0.get("emit_zero_pattern_n", "?")
+        runs.setdefault(arm, {})[seed] = dict(
+            n=len(rows), F=F, M=M, L=L, P=P, MF=M - F, pg=P - F,
+            k1=(P - F >= DELTA_PK and M >= F), alive=alive, pop_end=pops[-1],
+            p3=pops[-1] >= P3_GATE, pop_min=min(pops), g5=g5,
+            emit_ratio=emit_ratio, zero=zero, dev=dev, nan=flag,
+        )
+    print("== per-run (arm | seed | F M L | M-F | peak_gain | K1 | alive | pop_end | P3>=6945 | g5_dir | emit_ratio | zero_pat | device-echo | NaN) ==")
+    for arm in ARMS:
+        for seed in sorted(runs.get(arm, {})):
+            d = runs[arm][seed]
+            print(f"{arm} | {seed} | {d['F']:.4f} {d['M']:.4f} {d['L']:.4f} | {d['MF']:+.4f} | {d['pg']:.4f} | "
+                  f"{'K1Y' if d['k1'] else 'K1N'} | {'ALIVE' if d['alive'] else 'EXT'}({d['pop_end']:.0f}) | "
+                  f"{'P3Y' if d['p3'] else 'P3N'} | {d['g5']:.4f} | {d['emit_ratio']:.4f} | {d['zero']} | "
+                  f"{'OK' if not d['dev'] else '!!' + ';'.join(d['dev'])} | {d['nan'] or '-'}")
+    print("== K2 (main: arm vs same-tree anchor rep_w=0) + E-056 cross-tree check ==")
+    anchor = runs.get(0.0, {})
+    for arm in ARMS[1:]:
+        cells, dpg, xdev, xdev_a = [], [], [], []
+        pos = tot = miss = 0
+        for seed in sorted(E056_MF):
+            d = runs.get(arm, {}).get(seed)
+            da = anchor.get(seed)
+            if d is None or da is None or d["nan"] or da["nan"]:
+                miss += 1
+                continue
+            dd = d["MF"] - da["MF"]
+            tot += 1
+            pos += 1 if dd > 0 else 0
+            cells.append(f"s{seed}:{dd:+.4f}")
+            dpg.append(f"{d['pg'] - da['pg']:+.4f}")
+            xdev.append(f"{d['MF'] - E056_MF[seed]:+.4f}")
+            xdev_a.append(f"{da['MF'] - E056_MF[seed]:+.4f}")
+        ok = tot > 0 and pos / tot >= 0.8
+        alive_n = sum(1 for s in runs.get(arm, {}) if runs[arm][s]["alive"])
+        p3_n = sum(1 for s in runs.get(arm, {}) if runs[arm][s]["p3"])
+        gate = f"K3: alive {alive_n}/8 P3 {p3_n}/8"
+        verdict = "K2-ESTABLISHED" if ok else "K2-not-established"
+        if alive_n < 5 or p3_n < 5:
+            gate += " => NOT-EXECUTABLE (R3/R6)"
+            verdict = "K2-NOT-EXECUTABLE"
+        print(f"arm {arm}: pos {pos}/{tot} (missing {miss}) {verdict} [{gate}]")
+        print("   d(M-F) vs anchor : " + " ".join(cells))
+        print("   d(peak_gain) corroboration (report-only): " + " ".join(dpg))
+        print("   x-tree check vs E-056 arm: " + " ".join(xdev))
+        print("   x-tree check vs E-056 anchor: " + " ".join(xdev_a))
+    print(f"anchor solo x-tree spread |d(M-F)| max = "
+          f"{max((abs(anchor[s]['MF'] - E056_MF[s]) for s in anchor if s in E056_MF), default=float('nan')):.4f} "
+          f"(disclose if large; PI ruling pending)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
