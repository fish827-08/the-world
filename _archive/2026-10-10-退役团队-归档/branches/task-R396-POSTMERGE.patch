+def _landed_fields(j: dict) -> tuple[dict, str | None]:
+    """从 summary 里读"落盘装置字段"（只读已有件 ⇒ 零机时、不新造判据）。
+    优先级 readback(引擎真值) > meta(探针 argparse 生效值)。
+    返回 (值字典, 来源名)；来源名用于 msg 披露，让判读知道比的是哪一档真值。"""
+    for src in ("readback", "meta"):
+        d = j.get(src)
+        if isinstance(d, dict):
+            out = {}
+            for field, aliases in LANDED_ALIASES.items():
+                for a in aliases:
+                    if a in d:
+                        out[field] = d[a]
+                        break
+            if out:
+                return out, src
+    return {}, None
