+"""R396② `tools/postmerge_check.py` 靶向测试（骨架 v0）。
+
+钉三性质（改坏工具 ⇒ 必红）：
+  P1 计时列（`ms_per_tick`/`wall_s`）差异**不得**判红 ⇒ 否则巡检天天假红、门禁失去意义；
+  P2 整列全空/全 NaN **必**判红（静默零列族），且 `--allow-empty-col` 可显式豁免；
+  P3 tick 倒退/行列数不齐/缺 summary 成对 ⇒ 红；
+  P4 装置档回显：声明字段 ≠ 预设档 ⇒ 红（纪元级覆盖须显式批准，工具不代裁）；
+  P5 `main()` 退出码：全过=0 / 有红=1 / 什么都不给=2（不许"没查也绿"）。
+"""
+from __future__ import annotations
+
+import io
+import os
+
+import tools.postmerge_check as PC
+
+
+def _w(tmpdir, name, text):
+    p = os.path.join(str(tmpdir), name)
+    io.open(p, "w", encoding="utf-8", newline="").write(text)
+    return p
+
+
+def test_p1_timing_column_difference_is_not_a_failure(tmp_path):
+    a = _w(tmp_path, "a.csv", "seed,tick,pop,ms_per_tick\n7,10,21,1.11\n7,20,15,2.22\n")
+    b = _w(tmp_path, "b.csv", "seed,tick,pop,ms_per_tick\n7,10,21,9.99\n7,20,15,8.88\n")
+    assert PC.check_c7_pair(a, b)["status"] == "PASS"
+
+
+def test_p1b_real_state_difference_must_fail(tmp_path):
+    a = _w(tmp_path, "a.csv", "seed,tick,pop,ms_per_tick\n7,10,21,1.11\n")
+    b = _w(tmp_path, "b.csv", "seed,tick,pop,ms_per_tick\n7,10,22,1.11\n")
+    assert PC.check_c7_pair(a, b)["status"] == "FAIL"
+
+
+def test_p2_all_empty_column_fails_and_exemption_works(tmp_path):
+    p = _w(tmp_path, "x.csv",
+           "seed,tick,pop,g4_mem_bit_frac\n7,10,21,nan\n7,20,15,nan\n")
+    assert PC.check_integrity(p)["status"] == "FAIL"
+    ok = PC.check_integrity(p, frozenset({"g4_mem_bit_frac"}))
+    assert ok["status"] == "PASS", ok["msg"]
+
+
+def test_p3_tick_regression_and_ragged_rows_fail(tmp_path):
+    bad = _w(tmp_path, "bad.csv", "seed,tick,pop\n7,10,21\n7,9,15\n")
+    assert PC.check_integrity(bad)["status"] == "FAIL"
+    rag = _w(tmp_path, "rag.csv", "seed,tick,pop\n7,10,21,9\n7,20,15\n")
+    assert PC.check_integrity(rag)["status"] == "FAIL"
+    assert PC.check_pairing(bad)["status"] == "FAIL"          # 缺 .summary.json
+    _w(tmp_path, "bad.summary.json", '{"argv": []}')
+    assert PC.check_pairing(bad)["status"] == "PASS"
+
+
+def test_p4_device_declared_field_must_match_preset(tmp_path, monkeypatch):
+    s = _w(tmp_path, "run.summary.json",
+           '{"argv": ["--device", "s2", "--patches", "213", "--rows", "480"]}')
+    r = PC.check_device_echo(s)
+    assert r["status"] == "FAIL" and "patches" in r["msg"]     # 密度批式覆盖 ⇒ 须显式批准
+    s2 = _w(tmp_path, "ok.summary.json",
+            '{"argv": ["--device", "s2", "--rows", "480", "--cols", "960"]}')
+    assert PC.check_device_echo(s2)["status"] == "PASS"
+    s3 = _w(tmp_path, "mini.summary.json", '{"argv": ["--rows", "8"]}')
+    assert PC.check_device_echo(s3)["status"] == "SKIP"        # 微型批不传 device ⇒ 披露不判红
+
+
+def test_p5_exit_code_never_green_without_check(capsys):
+    assert PC.main(["--data-dir", "不存在的路径"]) == 2          # 环境错 ⇒ 2（不是"没查也绿"）
+    assert PC.main([]) == 2                                      # 三查一样没给 ⇒ 2
+    assert PC.main(["--selftest"]) == 0
