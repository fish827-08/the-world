+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""postmerge_check.py —— 合 main 之后的"三查"自动门禁（R396②，青梧提议获 PI 裁采纳）
+
+一句话：**把"合并后到底有没有把事情跑歪"从人眼值班变成脚本值班。**
+
+三查（全部零机时：只读已有产物，不跑批、不消费 RNG）：
+
+| # | 查什么 | 对应家规 | 判据 |
+|---|---|---|---|
+| **C7** | **仪器中立性采样对拍**：两份同配置 CSV 除计时列外须逐位一致 | AGENT.md §12.2 C7 | 不一致 ⇒ 观测件扰动了被测系统 = 行为变更（须按新配置重新登记） |
+| **回显** | **装置档回显对比**：批里 `--device X` 声明的装置字段，实际落盘值必须等于预设档 | R5.6 / R278 §三 / C4 | 任一字段被静默回落 = "跑出另一个装置的数据却毫无提示" |
+| **完整性** | **数据完整性**：CSV↔summary 成对、列数齐、`tick` 单调、末行 tick==ticks、整列全 NaN/空 ⇒ 报警 | 交付=提交 §3.1.3 / 静默零列族 | 缺件/断行/整列空 ⇒ 判读入口不可信 |
+
+用法
+----
+    # 巡检每班（合 main 后）——默认 strict：SKIP 也算不过
+    python tools/postmerge_check.py --data-dir the-world-data --limit 40
+    # C7 对拍（改了观测件之后，拿改前/改后两份同配置产物比）
+    python tools/postmerge_check.py --c7-baseline old.csv --c7-current new.csv
+    # 自检（无需任何数据，钉"计时列被排除""整列全空必红"两性质）
+    python tools/postmerge_check.py --selftest
+    # 宽松模式（SKIP 不计红，仅披露）——只用于考古旧批，不用于新合并
+    python tools/postmerge_check.py --data-dir the-world-data --lenient
+
+退出码：0 = 全过 ｜ 1 = 有 FAIL（或 strict 下有 SKIP）｜ 2 = 用法/环境错
+
+⚠️ 骨架 v0 的边界（诚实登记，别当成已完备）：
+  · C7 需要**人给两份产物路径**（跑对拍批属机时，须 fish 起跑令 R117 ⇒ 本工具不自跑）；
+  · 回显只核"命令行声明值 vs 预设档"，**不核**引擎运行期真值（那属 C4 读回，归
+    `experiments/preflight_check.py`）；
+  · 完整性不认识各 probe 私有 summary 结构，只做通用四查 + 成对检查。
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import io
+import json
+import os
+import sys
+
+# 从 `tools/` 直接跑时仓库根不在 sys.path ⇒ 挂上（否则 `import tools.*` 当场炸）
+_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if _ROOT not in sys.path:
+    sys.path.insert(0, _ROOT)
+
+try:
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
+except Exception:
+    pass
+
+# 计时列每次运行必然不同（wall-clock 读数）⇒ 逐位对拍必须排除，否则天天假红
+TIME_COLS = {"ms_per_tick", "wall_s"}
+# 装置字段（真源 tools/device_presets.py:DEVICE_PRESETS；R278 §三：只加不改）
+DEVICE_FIELDS = ("rows", "cols", "patches", "pop", "rgm",
+                 "bg_low_prod_frac", "bg_low_cap_mult")
+
+
+def _result(name: str, ok: bool, msg: str, skipped: bool = False) -> dict:
+    return {"check": name, "status": "SKIP" if skipped else ("PASS" if ok else "FAIL"),
+            "msg": msg}
+
+
+def read_table(path: str):
+    """CSV -> (header, rows)。行按位置存，避免列名重复时 DictReader 覆盖。"""
+    with open(path, "r", newline="", encoding="utf-8", errors="replace") as f:
+        rd = list(csv.reader(f))
+    if not rd:
+        raise ValueError(f"空 CSV：{path}")
+    return rd[0], [r for r in rd[1:] if r]
+
+
+def check_c7_pair(baseline: str, current: str) -> dict:
+    """C7：剥掉计时列后逐位比（列名集合须一致 ⇒ 加列要在交付说明里写明并各自剥离）。"""
+    if not baseline or not current:
+        return _result("c7-pair", False, "未给 --c7-baseline/--c7-current", skipped=True)
+    for p in (baseline, current):
+        if not os.path.isfile(p):
+            return _result("c7-pair", False, f"文件不存在：{p}")
+    h0, r0 = read_table(baseline)
+    h1, r1 = read_table(current)
+    keep0 = [i for i, c in enumerate(h0) if c not in TIME_COLS]
+    keep1 = [i for i, c in enumerate(h1) if c not in TIME_COLS]
+    n0, n1 = [h0[i] for i in keep0], [h1[i] for i in keep1]
+    if n0 != n1:
+        only0, only1 = set(n0) - set(n1), set(n1) - set(n0)
+        return _result("c7-pair", False,
+                       f"列名不一致（剔计时列后）：仅基线有 {sorted(only0)[:4]} "
+                       f"仅新表有 {sorted(only1)[:4]}")
+    a = [",".join(r[i] for i in keep0) for r in r0]
+    b = [",".join(r[i] for i in keep1) for r in r1]
+    if a != b:
+        i = next(k for k, (x, y) in enumerate(zip(a, b)) if x != y)
+        return _result("c7-pair", False, f"第 {i + 2} 行起逐位不一致 ⇒ 观测件扰动了被测系统")
+    return _result("c7-pair", True, f"逐位一致（{len(a)} 行 × {len(n0)} 列，已剔 {sorted(TIME_COLS)}）")
+
+
+def _argv_map(meta: dict) -> dict:
+    """summary 的 `argv`（p1c 族）或 `meta`（s3 族）-> 扁平 flag 字典。"""
+    out = {}
+    argv = meta.get("argv")
+    if isinstance(argv, list):
+        i = 0
+        while i < len(argv):
+            tok = str(argv[i])
+            if tok.startswith("--"):
+                key = tok[2:].replace("-", "_")
+                if i + 1 < len(argv) and not str(argv[i + 1]).startswith("--"):
+                    out[key] = str(argv[i + 1])
+                    i += 2
+                else:
+                    out[key] = "true"
+                    i += 1
+                continue
+            i += 1
+    for k, v in (meta.get("meta") or {}).items():
+        out.setdefault(str(k), str(v))
+    return out
+
+
+def check_device_echo(summary_path: str) -> dict:
+    """回显：批声明了 `--device X` ⇒ 落盘的装置字段必须等于预设档（不介入=旧行为，跳过）。"""
+    try:
+        from tools.device_presets import DEVICE_PRESETS
+    except Exception as e:
+        return _result("device-echo", False,
+                       f"读不到装置预设档（{type(e).__name__}: {e}）⇒ 无法回显对比")
+    j = json.load(io.open(summary_path, encoding="utf-8", errors="replace"))
+    flags = _argv_map(j if isinstance(j, dict) else {})
+    dev = flags.get("device")
+    if not dev:
+        return _result("device-echo", False, "无 --device（微型/考古批允许）", skipped=True)
+    preset = DEVICE_PRESETS.get(dev)
+    if preset is None:
+        return _result("device-echo", False, f"--device {dev!r} 不在预设档：{sorted(DEVICE_PRESETS)}")
+    bad = []
+    for field, want in preset.items():
+        got = flags.get(field)
+        if got is None:
+            continue                      # 没显式传 = 由预设档摁住 ⇒ 引擎侧另查（见文件头边界）
+        if str(got) != str(want):
+            bad.append(f"{field}: 声明 {got} ≠ 预设 {want}")
+    if bad:
+        return _result("device-echo", False, "; ".join(bad))
+    return _result("device-echo", True, f"--device {dev} 声明字段与预设档一致")
+
+
+def check_integrity(csv_path: str, allow_empty: frozenset = frozenset()) -> dict:
+    """完整性四查：列数齐 / 无重复列名 / tick 单调 / 整列全空（= 静默零列族）。"""
+    hdr, rows = read_table(csv_path)
+    if len(set(hdr)) != len(hdr):
+        dup = sorted({c for c in hdr if hdr.count(c) > 1})
+        return _result("integrity", False, f"重复列名 {dup[:5]}")
+    bad_w = [i for i, r in enumerate(rows) if len(r) != len(hdr)]
+    if bad_w:
+        return _result("integrity", False, f"{len(bad_w)} 行列数≠表头（首个 第{bad_w[0] + 2} 行）")
+    if not rows:
+        return _result("integrity", False, "有表头无数据行")
+    idx = {c: i for i, c in enumerate(hdr)}
+    if "tick" in idx:
+        ticks = [int(float(r[idx["tick"]])) for r in rows]
+        if any(b < a for a, b in zip(ticks, ticks[1:])):
+            return _result("integrity", False, "tick 非单调（行序坏了或被截断）")
+    all_empty = [c for c in hdr
+                 if c not in TIME_COLS and c not in allow_empty and idx[c] < len(rows[0])
+                 and all((not str(r[idx[c]]).strip()) or str(r[idx[c]]).strip().lower() in ("nan", "")
+                         for r in rows)]
+    if all_empty:
+        return _result("integrity", False,
+                       f"整列空/全 NaN（疑静默零列）：{all_empty[:6]}"
+                       f"{'…' if len(all_empty) > 6 else ''}"
+                       f"｜若该列按装置口径本应 n/a（例：G4 需 signal_alphabet='8'），"
+                       f"用 --allow-empty-col 显式豁免并在批记录写明理由")
+    return _result("integrity", True, f"{len(rows)} 行 × {len(hdr)} 列")
+
+
+def check_pairing(csv_path: str) -> dict:
+    side = os.path.splitext(csv_path)[0] + ".summary.json"
+    if not os.path.isfile(side):
+        return _result("pairing", False, f"缺 summary：{os.path.basename(side)}")
+    return _result("pairing", True, "CSV↔summary 成对")
+
+
+def sweep_data_dir(root: str, limit: int, results: list, allow_empty=frozenset()) -> None:
+    seen = 0
+    for dirpath, _dirs, files in os.walk(root):
+        for fn in sorted(files):
+            if seen >= limit:
+                return
+            p = os.path.join(dirpath, fn)
+            if fn.endswith(".csv"):
+                results.append(check_pairing(p))
+                try:
+                    results.append(check_integrity(p, allow_empty))
+                except Exception as e:
+                    results.append(_result("integrity", False, f"{p}: {type(e).__name__}: {e}"))
+                seen += 1
+            elif fn.endswith(".summary.json"):
+                try:
+                    results.append(check_device_echo(p))
+                except Exception as e:
+                    results.append(_result("device-echo", False, f"{p}: {type(e).__name__}: {e}"))
+
+
+def selftest() -> int:
+    """钉两性质：① 计时列差异不得判红；② 整列全空必红。改坏本工具 ⇒ 这里必炸。"""
+    import tempfile
+    d = tempfile.mkdtemp(prefix="postmerge_selftest_")
+    a = os.path.join(d, "a.csv")
+    b = os.path.join(d, "b.csv")
+    io.open(a, "w", encoding="utf-8", newline="").write(
+        "seed,tick,pop,ms_per_tick,g6_emit_rate_cum\n7,10,21,1.63,0.56\n7,20,15,1.71,0.58\n")
+    io.open(b, "w", encoding="utf-8", newline="").write(
+        "seed,tick,pop,ms_per_tick,g6_emit_rate_cum\n7,10,21,9.99,0.56\n7,20,15,8.88,0.58\n")
+    r1 = check_c7_pair(a, b)
+    io.open(b, "w", encoding="utf-8", newline="").write(
+        "seed,tick,pop,ms_per_tick,g6_emit_rate_cum\n7,10,21,1.63,\n7,20,15,1.71,nan\n")
+    r2 = check_integrity(b)
+    io.open(b, "w", encoding="utf-8", newline="").write(
+        "seed,tick,pop,ms_per_tick\n7,10,21,1.63\n7,9,15,1.71\n")
+    r3 = check_integrity(b)
+    ok = (r1["status"] == "PASS" and r2["status"] == "FAIL" and r3["status"] == "FAIL")
+    print(f"[selftest] 计时列豁免={r1['status']} 整列全空={r2['status']} "
+          f"tick 倒退={r3['status']} ⇒ {'PASS' if ok else 'FAIL'}")
+    for r in (r1, r2, r3):
+        print("   ", r["check"], r["status"], r["msg"])
+    return 0 if ok else 1
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description="合 main 后三查（C7 对拍/装置档回显/数据完整性）")
+    ap.add_argument("--data-dir", help="要扫的产物目录（如 the-world-data）")
+    ap.add_argument("--limit", type=int, default=40, help="最多扫多少个 CSV（默认 40）")
+    ap.add_argument("--c7-baseline", help="对拍基线 CSV")
+    ap.add_argument("--c7-current", help="对拍当前 CSV")
+    ap.add_argument("--lenient", action="store_true",
+                    help="SKIP 不计红（只用于考古旧批；新合并不建议）")
+    ap.add_argument("--selftest", action="store_true", help="跑内置自检（不需要任何数据）")
+    ap.add_argument("--allow-empty-col", action="append", default=[], metavar="COL",
+                    help="豁免某个「按装置口径本应 n/a」的列（可重复；须在批记录写理由）")
+    a = ap.parse_args(argv)
+    if a.selftest:
+        return selftest()
+    results = []
+    if a.c7_baseline or a.c7_current:
+        results.append(check_c7_pair(a.c7_baseline or "", a.c7_current or ""))
+    if a.data_dir:
+        if not os.path.isdir(a.data_dir):
+            print(f"🔴 --data-dir 不存在：{a.data_dir}", file=sys.stderr)
+            return 2
+        sweep_data_dir(a.data_dir, a.limit, results, frozenset(a.allow_empty_col))
+    if not results:
+        print("🔴 什么都没查（给 --data-dir 或 --c7-baseline/--c7-current，或 --selftest）",
+              file=sys.stderr)
+        return 2
+    counts = {"PASS": 0, "FAIL": 0, "SKIP": 0}
+    for r in results:
+        counts[r["status"]] += 1
+        if r["status"] != "PASS":
+            print(f"[{r['status']}] {r['check']} —— {r['msg']}")
+    verdict = ("FAIL" if counts["FAIL"] else
+               ("SKIP-red" if (not a.lenient and counts["SKIP"]) else "PASS"))
+    print(f"# postmerge_check: PASS={counts['PASS']} FAIL={counts['FAIL']} "
+          f"SKIP={counts['SKIP']} lenient={a.lenient} ⇒ {verdict}")
+    return 0 if verdict == "PASS" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
