+def _same_value(got, want) -> bool:
+    """数值/字符串两路比：先尝试 float 等（480 vs "480"、1.195 vs "1.195"），
+    再退到 str 等。NaN 与 NaN 视为等（不判红）；空值不参与比（由调用方过滤）。"""
