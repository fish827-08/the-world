@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""R289 验收：引擎快照补 `_mem_v2_rng` 键（记忆 v2 独立朝向流）。
+
+背景（T2/v3 发现，R289 补）：
+    `sphere_engine.py` 构造 `self._mem_v2_rng = default_rng(20260928)`，仅在
+    `memory_noise=True` 时被消费（记忆方位扰动）。`save_snapshot` 原本存了
+    `rng` / `_d2_rng` 却**漏了它** ⇒ 该档下"从快照续跑" ≠ "连续跑"（噪声流从
+    种子起点重放，续跑轨迹漂移）。本测试把"补键后逐位一致"钉死。
+
+口径：save→load 后 `_mem_v2_rng` 的**下一个抽样值**必须与保存点**逐位相同**。
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from simulation.sphere_engine import SphereEngine
+from experiments.steady_k_probe import make_cfg, apply_post_build
+
+# 微缩装置（够开出 memory_v2 + 噪声档；跑得快）
+DEV = dict(rows=24, cols=48, pop=60, patches=8, rgm=1.195)
+
+
+def _build(memory_noise: bool, seed: int = 7) -> SphereEngine:
+    """建一个开了 memory_v2(+噪声) 的小引擎（口径抄 S3 `_build_fresh_run`）。"""
+    c, notes = make_cfg(
+        seed, DEV["rows"], DEV["cols"], DEV["pop"], DEV["patches"], True,
+        0.125, 0.125, 80, 2.5, 30000, DEV["rgm"],
+        bg_low_prod_frac=0.4, bg_low_cap_mult=0.05,
+    )
+    c.simulation.use_sim_core = False
+    c.resource_dynamics.enabled = True
+    c.info_structure.memory_v2 = True
+    c.info_structure.memory_gradient = "orientation"
+    # 🔴 本测试的关键：打开噪声档 ⇒ 消费 _mem_v2_rng
+    c.info_structure.memory_noise = bool(memory_noise)
+    c.info_structure.memory_noise_p = 0.5      # 抬高概率，确保抽样真的动起来
+    eng = SphereEngine(c)
+    apply_post_build(eng, notes)
+    return eng
+
+
+def test_precondition_mem_noise_on():
+    """前置：memory_noise=True 确实让引擎进入噪声档（否则本测试无意义）。"""
+    eng = _build(memory_noise=True)
+    assert bool(getattr(eng, "_mem_noise", False)) is True, \
+        "memory_noise 未生效 ⇒ 测试前提不成立"
+
+
+def test_snapshot_contains_mem_v2_rng_key(tmp_path):
+    """save_snapshot 必须写出 `mem_v2_rng_state` 键（本 R289 修复的硬要求）。"""
+    eng = _build(memory_noise=True)
+    p = str(tmp_path / "s.npz")
+    eng.save_snapshot(p)
+    data = np.load(p, allow_pickle=True)
+    assert "mem_v2_rng_state" in data.files, \
+        f"快照缺 mem_v2_rng_state；实际键：{sorted(data.files)}"
+
+
+def test_mem_v2_rng_roundtrip_restores_exact_state(tmp_path):
+    """save→load 后 `_mem_v2_rng` 的下一个抽样值必须与保存前**逐位相同**。"""
+    eng = _build(memory_noise=True)
+    # 先消费几个噪声样本，让流离开"刚播种"状态（否则测不出恢复是否生效）
+    for _ in range(5):
+        eng._mem_v2_rng.random(3)
+    p = str(tmp_path / "s.npz")
+    eng.save_snapshot(p)
+    expected = eng._mem_v2_rng.random(4)      # 保存点的"下一个"值
+
+    eng2 = SphereEngine.load_snapshot(p)
+    got = eng2._mem_v2_rng.random(4)
+    assert np.array_equal(expected, got), "mem_v2_rng 流未按快照恢复 ⇒ 续跑不逐位"
+
+
+def test_mem_v2_rng_survives_stepping(tmp_path):
+    """端到端：跑若干 tick（真实消费噪声流）→ save→load → 续跑与连续跑一致。
+
+    这是本修复的最终目的：sample 级续跑在**噪声档**下也逐位可续。
+    """
+    eng_a = _build(memory_noise=True)
+    for _ in range(8):
+        eng_a.step()
+    p = str(tmp_path / "mid.npz")
+    eng_a.save_snapshot(p)
+
+    # 分叉 A：从快照续跑 8 tick
+    eng_a2 = SphereEngine.load_snapshot(p)
+    for _ in range(8):
+        eng_a2.step()
+
+    # 分叉 B：同一引擎不保存、继续跑 8 tick
+    for _ in range(8):
+        eng_a.step()
+
+    # N（种群）与 tick 必须一致
+    nA = int(getattr(eng_a2, "N", getattr(eng_a2, "_n", -1)))
+    nB = int(getattr(eng_a, "N", getattr(eng_a, "_n", -1)))
+    assert int(eng_a2._tick) == int(eng_a._tick)
+    assert nA == nB, f"续跑后 N={nA} ≠ 连续跑 N={nB}（快照未覆盖噪声流？）"
+    # 噪声流的下一个样本也必须相同（流确定性延续）
+    assert np.array_equal(eng_a2._mem_v2_rng.random(4),
+                          eng_a._mem_v2_rng.random(4)), \
+        "续跑与连续跑的 mem_v2_rng 流飘移 ⇒ 不逐位"
+
+
+def test_old_snapshot_without_key_does_not_crash(tmp_path):
+    """旧快照（无 mem_v2_rng_state 键）⇒ load 不崩（保持构造期播种，不静默错位）。"""
+    eng = _build(memory_noise=True)
+    p = str(tmp_path / "s.npz")
+    eng.save_snapshot(p)
+    # 手工删掉该键，模拟"补键之前"产出的旧快照
+    data = dict(np.load(p, allow_pickle=True))
+    data.pop("mem_v2_rng_state", None)
+    np.savez(p, **data)
+    eng2 = SphereEngine.load_snapshot(p)      # 不应抛异常
+    assert hasattr(eng2, "_mem_v2_rng")
