- memory_ttl=DURATION（tick 计时）/ memory_noise_p=PROB（每 tick 概率）
- dist_scale / degrade_thr / coarse_gain=INVARIANT（格 / 无量纲）
- 证据 = config 字段注释原文 + 引擎用法；guard 9/9 绿、工具 rc=0
---
 tools/tick_denomination_audit.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tools/tick_denomination_audit.py b/tools/tick_denomination_audit.py
index 700d971b..3e494653 100644
--- a/tools/tick_denomination_audit.py
+++ b/tools/tick_denomination_audit.py
@@ -185,6 +185,12 @@ KNOWN: dict[str, str] = {
     "info_structure.perception_noise": INVARIANT,
     "info_structure.memory_gradient_gain": INVARIANT,
     "info_structure.memory_weight_gene": INVARIANT,  # 13.11 开关（bool）—— 乘子只改打分权重，不承载 tick 面额
+    # ---- 记忆 v2 七字段其余五个（T5 `b23186d` 随树引入；R298 后补录，逐条核过用法）----
+    "info_structure.memory_dist_scale": INVARIANT,   # 距离衰减尺度 d0=**格**（`exp(−d/d0)`，d 按移动事件累加）⇒ 空间量
+    "info_structure.memory_degrade_thr": INVARIANT,  # 「精→粗降级距离阈值（**格**）」（config 注释原文）⇒ 空间量
+    "info_structure.memory_coarse_gain": INVARIANT,  # 增益倍率（无量纲；同 memory_gradient_gain）
+    "info_structure.memory_ttl": DURATION,           # 「记忆时效（**tick**）」⇒ 用法 `self._tick − ticks <= ttl`，压缩时 ÷k
+    "info_structure.memory_noise_p": PROB,           # 「**每 tick** 以 p 概率扰动记忆方位 ±1 档」⇒ 1−(1−p)^k
     "info_structure.perception_radius": INVARIANT,
     "pleasure.optimism": INVARIANT,
     "pleasure.w_energy": INVARIANT,
