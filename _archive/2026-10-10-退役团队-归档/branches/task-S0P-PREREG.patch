+# S0′-a 平账微探针（predation-off）· 5seed×200t · 产出=缺口清单非读数（R117）
+# 派生自 experiments/stepa_leg_readout.py 调用形；口径=E-CONSERVE 判据稿一行恒等式（起草未锁）
+from __future__ import annotations
+import json, sys, time
+from pathlib import Path
+import numpy as np
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+try:
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+except Exception:
+    pass
+
+from simulation.config import EnergyProbeConfig, SimConfig
+from simulation.sphere_engine import (
+    SphereEngine, EP_CHANNELS, EP_IMPLEMENTED, EP_IDX,
+    EC_FORAGE, EC_PRED, EC_PHOTO, EC_META, EC_MOVE, EC_ATTACK, EC_SCAV,
+)
+
+SEEDS = [7, 8, 9, 10, 11]
+TICKS = 200
+ROW_EVERY = 50
+EC_NAMES = ["forage", "pred", "photo", "meta", "move", "attack", "scav"]
+EC_IDX = [EC_FORAGE, EC_PRED, EC_PHOTO, EC_META, EC_MOVE, EC_ATTACK, EC_SCAV]
+
+
+def stocks(e: SphereEngine):
+    P = int(len(e._id))
+    return {
+        "pop_n": P,
+        "sum_energy": float(e._energy[:P].sum()) if P else 0.0,
+        "sum_stomach": float(e._stomach[:P].sum()) if P else 0.0,
+        "sum_stomach_scav": float(e._stomach_scav[:P].sum()) if P else 0.0,
+        "sum_grid": float(e.resources._grid.sum()),
+    }
+
+
+def run_one(seed: int):
+    cfg = SimConfig(seed=int(seed))
+    cfg.simulation.use_sim_core = False
+    cfg.predation.enabled = False          # 🔴 变体核心：无捕食
+    cfg.energy_probe = EnergyProbeConfig(enabled=True, row_every=ROW_EVERY)
+    e = SphereEngine(cfg)
+    prev_ec = e._ec_global.copy()
+    prev_ep = e._ep_total.copy()
+    prev_s = stocks(e)
+    rows = [{"tick": 0, **prev_s,
+             **{f"ec_{n}": 0.0 for n in EC_NAMES},
+             **{f"ep_{n}": 0.0 for n in EP_CHANNELS}}]
+    ticks = 0
+    for _ in range(TICKS):
+        if e.extinct:
+            break
+        e.step()
+        ticks += 1
+        s = stocks(e)
+        d_ec = e._ec_global - prev_ec
+        d_ep = e._ep_total - prev_ep
+        row = {"tick": ticks, **s}
+        for n, i in zip(EC_NAMES, EC_IDX):
+            row[f"ec_{n}"] = float(d_ec[i])
+        for n in EP_CHANNELS:
+            v = float(d_ep[EP_IDX[n]]) if n in EP_IMPLEMENTED else None
+            row[f"ep_{n}"] = v
+        rows.append(row)
+        prev_ec, prev_ep, prev_s = e._ec_global.copy(), e._ep_total.copy(), s
+    if ticks != TICKS:
+        raise RuntimeError(f"自检①失败：seed={seed} 只跑 {ticks}/{TICKS}（灭绝早停）")
+    for n in ("pred", "attack"):
+        col = float(np.sum([r[f"ec_{n}"] for r in rows]))
+        if col != 0.0:
+            raise RuntimeError(f"自检③失败：predation-off 下 ec_{n} 累计={col} ≠ 0")
+    ep_pred = float(np.sum([r["ep_dis_attack"] or 0.0 for r in rows]))
+    return {"seed": seed, "ticks": ticks, "rows": rows,
+            "totals": e.energy_probe_totals(),
+            "ec_global": {n: float(e._ec_global[i]) for n, i in zip(EC_NAMES, EC_IDX)},
+            "check": {"dis_attack_sum": ep_pred, "digest_check": None}}
+
+
+def residual_analysis(run):
+    """一行判据残差：Δ存量 = Σec收入 − Σec支出 − Σep蒸发 − Σep逃逸；逐tick与非终差并报。"""
+    rows = run["rows"]
+    res = []
+    for r in rows[1:]:
+        d_stock = (r["sum_energy"] - rows[r["tick"] - 1]["sum_energy"]
+                   + r["sum_stomach"] - rows[r["tick"] - 1]["sum_stomach"]
+                   + r["sum_stomach_scav"] - rows[r["tick"] - 1]["sum_stomach_scav"]
+                   + r["sum_grid"] - rows[r["tick"] - 1]["sum_grid"])
+        income = r["ec_forage"] + r["ec_scav"] + r["ec_photo"]   # pred=0（门已核）
+        spend = r["ec_meta"] + r["ec_move"] + r["ec_attack"]
+        evap = sum(r[f"ep_{n}"] or 0.0 for n in EP_IMPLEMENTED if n.startswith("dis_"))
+        esc = sum(r[f"ep_{n}"] or 0.0 for n in EP_IMPLEMENTED if n.startswith("esc_"))
+        res.append({"tick": r["tick"], "d_stock": d_stock,
+                    "rhs": income - spend - evap - esc,
+                    "resid": d_stock - (income - spend - evap - esc)})
+    rv = np.array([x["resid"] for x in res])
+    final = {"d0": rows[0], "dn": rows[-1]}
+    tot_d = (final["dn"]["sum_energy"] + final["dn"]["sum_stomach"]
+             + final["dn"]["sum_stomach_scav"] + final["dn"]["sum_grid"]) - (
+             final["d0"]["sum_energy"] + final["d0"]["sum_stomach"]
+             + final["d0"]["sum_stomach_scav"] + final["d0"]["sum_grid"])
+    return {"tickwise_absmax": float(np.max(np.abs(rv))),
+            "tickwise_mean": float(np.mean(np.abs(rv))),
+            "cum_resid": float(rv.sum()), "cum_resid_vs_stock0":
+            float(rv.sum() / max(rows[0]["sum_energy"] + rows[0]["sum_stomach"]
+                                 + rows[0]["sum_grid"], 1e-9))}
+
+
+def main():
+    out = {"tool": Path(__file__).name,
+           "purpose": "S0′-a E-CONSERVE 平账微探针（predation-off）——缺口清单非读数（R117）",
+           "caliber": {"grid": "60x120 默认微型档", "patch_count": 30,
+                       "resource_dynamics": "off（仓库默认）", "corpse": "off（默认）",
+                       "predation": "off（🔴 变体）", "use_sim_core": False,
+                       "seeds": SEEDS, "ticks": TICKS, "row_every": ROW_EVERY,
+                       "population": "仓库默认（stepa 同款不覆盖）",
+                       "identity": "Δ(Σe+Σstomach+Σscav+Σgrid)=Σec(forage+scav+photo−meta−move−attack)−Σep(dis_*+esc_*)[待锁]"},
+           "runs": []}
+    for sd in SEEDS:
+        t0 = time.perf_counter()
+        run = run_one(sd)
+        run["wall_s"] = round(time.perf_counter() - t0, 2)
+        run["residual"] = residual_analysis(run)
+        out["runs"].append(run)
+        print(f"seed {sd}: wall={run['wall_s']}s resid_absmax="
+              f"{run['residual']['tickwise_absmax']:.3f} cum={run['residual']['cum_resid']:.3f}",
+              flush=True)
+    Path("out_ec_audit_probe.json").write_text(
+        json.dumps(out, ensure_ascii=False), encoding="utf-8")
+    print("DONE -> out_ec_audit_probe.json")
+
+
+if __name__ == "__main__":
+    main()
