+# ---------------------------------------------------------------- T8 只读零 RNG
+
+def test_t8_read_only_and_zero_rng():
+    eng = _Eng()
+    for c, s in zip(range(4), (1, 2, 3, 4)):
+        _set_env(eng, c, s_pat=s, food=(0.9 if c % 2 else 0.0), cap=1.0)
+    m0 = _m0()
+    m0.attach(eng)
+    snap = {
+        "flat": eng._flat.copy(), "id": eng._id.copy(),
+        "marks": eng.signals._marks.copy(), "age": eng.signals._age.copy(),
+        "grid": eng.resources._grid.copy(), "cap": eng.resources._capacity.copy(),
+        "genes": eng._genes.copy(),
+    }
+    for t in (1, 2):
+        m0.after_step(eng, t, sampled=(t == 2))
+    row = m0.sample_cols(eng)
+    m0.l1_pooled([row])
+    assert int(eng._mem_bit_on) == 0 and int(eng._mem_bit_n) == 0   # 没替引擎累计
+    assert eng.main_rng.calls == 0                    # 🔴 零主 RNG
+    np.testing.assert_array_equal(eng._flat, snap["flat"])
+    np.testing.assert_array_equal(eng._id, snap["id"])
+    np.testing.assert_array_equal(eng.signals._marks, snap["marks"])
+    np.testing.assert_array_equal(eng.signals._age, snap["age"])
+    np.testing.assert_array_equal(eng.resources._grid, snap["grid"])
+    np.testing.assert_array_equal(eng.resources._capacity, snap["cap"])
+    np.testing.assert_array_equal(eng._genes, snap["genes"])
