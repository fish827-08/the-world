+"""L1-JOINTCOL：`_M0Instruments` 的「信号↔环境」联合计数列组纯单元测试（stub 最小引擎）。
+
+口径真值 = 砚《GAP-B 盘点+需求单》§3.1/§3.2（@a0feedb）+ PI 三裁（板帖 PI③）：
+  裁①原始联合计数（不出 `mi_*` 值列）｜裁②逐采样窗粒度入主表 + run 级 summary 键｜
+  裁③审计最小集 = `l1_joint_n` 曝光 + occ=0 空窗剔除率 fail-loud。
+
+覆盖（不跑真引擎 ⇒ 秒级）：
+  T1 手算锚（4 个体 (s,e) → 16 格精确计数 + 行和）；
+  T2 逐窗清零（第二窗不吞第一窗）；
+  T3 🔴 环境端 = 富指示本身，**不是 mem_bit**（换成 mem_bit 必红）；
+  T4 alphabet ≠ '8' ⇒ attach fail-loud；T5 接收态越档 ⇒ fail-loud；
+  T6 格号越界 ⇒ fail-loud（PI③：不设 env_unknown 列，炸）；
+  T7 灭绝窗 n=0（是 0 不是 NaN）+ 空窗剔除率门两向；
+  T8 只读 & 零 RNG（引擎状态逐位不变 + rng 调用计数 0）；
+  T9 列集 17/唯一/与 _M0_COLS 不相交/表尾次序；
+  T10 默认关 ⇒ 不新增键、不要求 resources、l1_pooled 调用点漏门即炸；
+  T11 行和不变量破了 ⇒ fail-loud；T12 pooled 键数值（手算锚）。
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from experiments.s3_memory_probe import (
+    FOOD_RICH_LEVEL, _L1_CELL_COLS, _L1_COLS, _L1_EMPTY_GATE, _L1_K, _M0_COLS,
+    _M0Instruments,
+)
+
+
+class _Sig:
+    def __init__(self, n, duration=5):
+        self._marks = np.zeros(n, dtype=np.uint8)
+        self._age = np.zeros(n, dtype=np.int32)
+        self.duration = int(duration)
+
+    def write(self, cell, pat):
+        self._marks[cell] = np.uint8(pat)
+        self._age[cell] = self.duration
+
+    def read_many(self, cells):                       # 与 world/signal_field.py:120 同形
+        return self._marks[cells].copy()
+
+
+class _Res:
+    def __init__(self, n):
+        self._grid = np.zeros(n, dtype=np.float64)
+        self._capacity = np.zeros(n, dtype=np.float64)
+
+    def set(self, cell, food, cap):
+        self._grid[cell] = food
+        self._capacity[cell] = cap
+
+
+class _Rng:
+    """记账用假 RNG：任何调用都被计数（T8 钉"零主 RNG"）。"""
+
+    def __init__(self):
+        self.calls = 0
+
+    def random(self, *a, **k):
+        self.calls += 1
+        return 0.5
+
+    def integers(self, *a, **k):
+        self.calls += 1
+        return 0
+
+    def __getattr__(self, name):
+        def _boom(*a, **k):
+            self.calls += 1
+            return None
+        return _boom
+
+
+class _World:
+    def __init__(self, rows=4, cols=8):
+        self.rows, self.cols = rows, cols
+        self._pole_top, self._pole_bottom = 0, rows - 1
+        n = rows * cols
+        self._nb_table = np.tile(np.arange(n, dtype=np.int64)[:, None], (1, 8))
+        self._pole_nb = np.array([np.arange(cols), np.full(cols, cols)], dtype=np.int64)
+
+
+class _Eng:
+    def __init__(self, rows=4, cols=8):
+        n = rows * cols
+        self.signals = _Sig(n)
+        self.world = _World(rows, cols)
+        self.resources = _Res(n)
+        self._nb_table = self.world._nb_table
+        self._pole_nb = self.world._pole_nb
+        self._flat = np.array([0, 1, 2, 3], dtype=np.int64)
+        self._id = np.array([10, 11, 12, 13], dtype=np.int64)
+        self._genes = np.zeros((4, 32), dtype=np.float64)
+        self._genes[:, 15] = 0.5
+        self._mem_bit_on = 0
+        self._mem_bit_n = 0
+        self._alpha = "8"
+        self.main_rng = _Rng()
+
+
+def _m0(l1=True):
+    return _M0Instruments(l1_joint=l1)
+
+
+def _set_env(eng, cell, s_pat, food, cap):
+    """给定格：接收态 = s_pat；富指示 = (food > 0.5 * cap)。"""
+    eng.signals.write(cell, s_pat)
+    eng.resources.set(cell, food, cap)
+
+
+# ---------------------------------------------------------------- 列集本身
+
+def test_t9_column_set_is_17_unique_tail_appended():
+    assert _L1_K == 8
+    assert len(_L1_CELL_COLS) == 16
+    assert _L1_CELL_COLS[:4] == ["l1_joint_s0_e0", "l1_joint_s0_e1",
+                                 "l1_joint_s1_e0", "l1_joint_s1_e1"]
+    assert _L1_COLS == _L1_CELL_COLS + ["l1_joint_n"]          # 表尾 = 曝光列
+    assert len(set(_L1_COLS)) == 17
+    assert not (set(_L1_COLS) & set(_M0_COLS))                 # 与既有 36 列不相交
+    assert _L1_EMPTY_GATE == 0.2                               # 阈值出处=C1 J-B①，实现侧不擅自放宽
+
+
+# ---------------------------------------------------------------- T1 手算锚
+
+def test_t1_hand_anchored_joint_counts():
+    eng = _Eng()
+    _set_env(eng, 0, s_pat=1, food=0.9, cap=1.0)      # s=1 e=1
+    _set_env(eng, 1, s_pat=1, food=0.1, cap=1.0)      # s=1 e=0
+    _set_env(eng, 2, s_pat=0, food=0.9, cap=1.0)      # s=0 e=1
+    _set_env(eng, 3, s_pat=6, food=0.2, cap=0.4)      # s=6 e=0（0.2 ≤ 0.5*0.4=0.2 ⇒ 不富）
+    m0 = _m0()
+    m0.attach(eng)
+    m0.after_step(eng, 1, sampled=True)
+    d = m0.sample_cols(eng)
+    assert d["l1_joint_s1_e1"] == 1
+    assert d["l1_joint_s1_e0"] == 1
+    assert d["l1_joint_s0_e1"] == 1
+    assert d["l1_joint_s6_e0"] == 1
+    assert d["l1_joint_n"] == 4                                   # = 个体数
+    assert sum(int(d[c]) for c in _L1_CELL_COLS) == d["l1_joint_n"]   # 行和不变量
+    assert all(int(d[c]) == 0 for c in _L1_CELL_COLS
+               if c not in ("l1_joint_s1_e1", "l1_joint_s1_e0",
+                            "l1_joint_s0_e1", "l1_joint_s6_e0"))
+    assert all(isinstance(d[c], int) for c in _L1_COLS)          # 原始计数 = int，不是浮点
+
+
+def test_t1b_rich_boundary_is_strict_gt():
+    """富指示与引擎同式 = `>` 不是 `>=`（FOOD_RICH_LEVEL=0.5；R121 只命名不改数值）。"""
+    eng = _Eng()
+    _set_env(eng, 0, s_pat=1, food=FOOD_RICH_LEVEL * 1.0, cap=1.0)   # 恰等 ⇒ 不富
+    _set_env(eng, 1, s_pat=1, food=0.5000001, cap=1.0)               # 略高 ⇒ 富
+    m0 = _m0()
+    m0.attach(eng)
+    m0.after_step(eng, 1, sampled=True)
+    d = m0.sample_cols(eng)
+    assert d["l1_joint_s1_e0"] == 1 and d["l1_joint_s1_e1"] == 1
+
+
+# ---------------------------------------------------------------- T2 逐窗
+
+def test_t2_windows_are_per_window_not_cumulative():
+    eng = _Eng()
+    _set_env(eng, 0, s_pat=2, food=0.9, cap=1.0)
+    m0 = _m0()
+    m0.attach(eng)
+    for t in (1, 2, 3):                                  # 第一窗 3 个 tick
+        m0.after_step(eng, t, sampled=(t == 3))
+    r1 = m0.sample_cols(eng)
+    assert r1["l1_joint_s2_e1"] == 3 and r1["l1_joint_n"] == 12   # 3 tick × 4 个体
+    m0.after_step(eng, 4, sampled=True)                  # 第二窗只 1 个 tick
+    r2 = m0.sample_cols(eng)
+    assert r2["l1_joint_s2_e1"] == 1 and r2["l1_joint_n"] == 4    # 不吞上一窗
+    assert m0.l1_windows == 2 and m0.l1_empty_windows == 0
+
+
+# ---------------------------------------------------------------- T3 禁 mem_bit
+
+def test_t3_environment_side_is_rich_indicator_not_mem_bit():
+    """🔴 卡面硬约束：e 端取"富指示"本身。若实现误取 `_mem_bit_*`（'8' 档下
+    `state = e_bin*2 + mem_bit` ⇒ MI 发送者一半恒真），本例必红。
+    """
+    eng = _Eng()
+    eng._mem_bit_on, eng._mem_bit_n = 4, 4               # mem_bit 全 1（假代理会全判"富"）
+    for c in (0, 1, 2, 3):
+        _set_env(eng, c, s_pat=3, food=0.0, cap=1.0)     # 实际全场"不富"
+    m0 = _m0()
+    m0.attach(eng)
+    m0.after_step(eng, 1, sampled=True)
+    d = m0.sample_cols(eng)
+    assert d["l1_joint_s3_e0"] == 4 and d["l1_joint_s3_e1"] == 0
+    p = m0.l1_pooled([d])
+    assert "mem_bit" not in p["l1_env_source"] and "_grid" in p["l1_env_source"]
+
