+    # ---- 🔴 L1-JOINTCOL：(信号↔环境) 联合计数（只读、零 RNG、fail-loud）----
+
+    def _attach_l1(self, eng) -> None:
+        """L1 列组的装配自检：缺件即炸，**不许静默降档**。"""
+        for attr in ("_grid", "_capacity"):
+            if not hasattr(eng.resources, attr):
+                raise RuntimeError(
+                    f"🔴 M0 L1 装配失败：resources.{attr} 不存在（环境端富指示需要它）")
+        if not hasattr(eng.signals, "read_many"):
+            raise RuntimeError("🔴 M0 L1 装配失败：signals.read_many 不存在（接收态读数）")
+        if int(eng.resources._grid.size) != int(eng.resources._capacity.size):
+            raise RuntimeError(
+                f"🔴 M0 L1 装配失败：_grid 格数={int(eng.resources._grid.size)} ≠ "
+                f"_capacity 格数={int(eng.resources._capacity.size)} ⇒ 富指示比较式失去意义")
+        if str(getattr(eng, "_alpha", "")) != "8":
+            raise RuntimeError(
+                f"🔴 M0 L1 装配失败：signal_alphabet="
+                f"{getattr(eng, '_alpha', None)!r} ≠ '8' ⇒ 信号态实际取值 0..15，而本列组"
+                f"只有 s0..s7 八档 ⇒ 8..15 态会被**静默丢弃**（MI 直接偏低且事后无从查出）。"
+                f"二选一：装置切 \"8\"（M1 锁定档；顶层 CLI 见卡 S3-RDSWITCH），"
+                f"或本次**不带** --l1-joint。需求单 §四 已把这两路交给实施线，此处取后者兜底。")
+
+    def _l1_accumulate(self, eng) -> None:
+        """本步末逐存活个体记 (s, e)；同窗内多次到访**照计**（需求单 §3.2 时规）。"""
+        cur = np.asarray(eng._flat, dtype=np.int64)
+        n = int(cur.size)
+        if n == 0:                          # 灭绝：本 tick 零曝光（窗末 `l1_joint_n` 记 0）
+            return
+        grid = np.asarray(eng.resources._grid)
+        cap = np.asarray(eng.resources._capacity)
+        if int(cur.min()) < 0 or int(cur.max()) >= int(grid.size):
+            raise RuntimeError(
+                f"🔴 M0 L1：个体格号越界（min={int(cur.min())} max={int(cur.max())} "
+                f"格数={int(grid.size)}）⇒ 联合读数不可信，停跑。"
+                f"（需求单 §3.1 的 `l1_joint_env_unknown_n` 审计列按 PI③ 最小集**不设**，"
+                f"实施线结论 = 此分支属引擎不变量违背，应炸不应计数。）")
+        s = np.asarray(eng.signals.read_many(cur), dtype=np.int64)
+        if int(s.max()) >= _L1_K:
+            raise RuntimeError(
+                f"🔴 M0 L1：接收态出现 {int(s.max())} ≥ {_L1_K} ⇒ 装置实际不是 '8' 档"
+                f"（attach 断言被绕过，例：运行中被改档）。本列组会静默丢态 ⇒ 停跑不出列。")
+        e = (grid[cur] > FOOD_RICH_LEVEL * cap[cur]).astype(np.int64)
+        self.l1_acc += np.bincount(s * 2 + e, minlength=_L1_K * 2)
+        self.l1_win_n += n
+
+    def l1_pooled(self, rows) -> dict:
+        """run 级汇总键（PI③ 最小集）：16 格池 + 曝光 + occ=0 空窗剔除率门。
+
+        🔴 这里**只出计数**，不出任何 MI/熵值 ⇒ 判读权（算式与阈值）完整留在砚侧，
+        且复算不依赖本探针代码段（需求单 §3.4 的独立性论证照此兑现）。
+        """
+        if not self.l1_joint:
+            raise RuntimeError("🔴 M0 L1：`--l1-joint` 关 ⇒ 不该产 run 级键（调用点漏了门）")
+        if not rows:
+            raise RuntimeError(
+                "🔴 M0 L1 审计门：本 run 无任何采样行 ⇒ 联合计数无从汇总（不静默出空键）")
+        tot = np.zeros(_L1_K * 2, dtype=np.int64)
+        n_win = 0
+        n_empty = 0
+        sum_n = 0
+        for r in rows:
+            for i, name in enumerate(_L1_CELL_COLS):
+                tot[i] += int(r[name])
+            _n = int(r["l1_joint_n"])
+            sum_n += _n
+            n_win += 1
+            if _n == 0:
+                n_empty += 1
+        if int(tot.sum()) != sum_n:
+            raise RuntimeError(
+                f"🔴 M0 L1 审计门：行和不变量破了（16 格合计 {int(tot.sum())} ≠ "
+                f"Σ l1_joint_n {sum_n}）⇒ 计数或列名错位，停跑。"
+                f"（需求单 §3.3-5「行和 = Σ 窗内计数点」）")
+        frac = n_empty / float(n_win)
+        if frac > _L1_EMPTY_GATE:
+            raise RuntimeError(
+                f"🔴 M0 L1 审计门（PI③）：occ=0 空窗剔除率 {n_empty}/{n_win} = {frac:.3f} > "
+                f"{_L1_EMPTY_GATE} ⇒ 本 run 的联合表只覆盖少数采样窗（多半中途灭绝后大面积零曝光），"
+                f"MI(signal↔env) 无从判读 ⇒ 停跑不出 summary。"
+                f"阈值出处 = C1 J-B① 先例，改判归砚/PI（R225），不在实现侧放宽。")
+        out = {name: int(tot[i]) for i, name in enumerate(_L1_CELL_COLS)}
+        out["l1_joint_n"] = sum_n
+        out["l1_windows"] = n_win
+        out["l1_empty_windows"] = n_empty
+        out["l1_empty_window_frac"] = round(frac, 4)
+        out["l1_empty_gate"] = _L1_EMPTY_GATE
+        out["l1_joint_sig_states"] = _L1_K
+        out["l1_env_source"] = "resources._grid > FOOD_RICH_LEVEL * _capacity"
+        out["l1_note"] = ("原始联合计数（充分统计量）；逐采样窗非归一、同窗多次到访照计；"
+                          "s=受方格接收态(read_many，非发射态)；e=富指示本身(🔴非 mem_bit 代理)；"
+                          "MI 与 I-3/I-4 零模型由这 17 列离线复算，探针内不出值列")
+        return out
+
