+def test_t7b_empty_window_gate_fires_above_20pct():
+    eng = _Eng()
+    _set_env(eng, 0, s_pat=1, food=0.9, cap=1.0)
+    m0 = _m0()
+    m0.attach(eng)
+    rows = []
+    for t in range(1, 6):                               # 5 窗：窗 3..5 空 ⇒ 3/5 = 60%
+        if t >= 3:
+            eng._flat = np.zeros(0, dtype=np.int64)
