+def _cli(extra):
+    """走真 `main()` 的参数校验腿（微型档 ⇒ 命中拦令即 rc=2，不进任何 run）。"""
+    env = dict(os.environ)
+    env.update(OMP_NUM_THREADS="1", PYTHONUTF8="1")
+    return subprocess.run(
+        [sys.executable, "-u", "-m", "experiments.s3_memory_probe",
+         "--rows", "8", "--cols", "16", "--patches", "2", "--pop", "4",
+         "--ticks", "5", "--sample", "5", "--seeds", "999", "--arms", "on",
+         "--out", os.path.join(tempfile.gettempdir(), "l1_cli_guard.csv"), *extra],
+        cwd=str(Path(__file__).resolve().parents[1]), env=env,
+        capture_output=True, text=True)
+
+
+def test_t13_l1_joint_and_append_is_exit2_not_silent_subset():
+    """🔴 镜 队列⑤ 🟡-1 / PI 00:10 裁「禁组合」：`--l1-joint` + `--append` ⇒ rc=2。
+
+    放过 = `--append` 跳过已完成 run 后，run 级 `l1_*` 只汇总本进程的窗 ⇒ 与 CSV
+    逐窗行两套口径（把本拦令删掉，本例必红；改成只告警不拦，rc 变 0 ⇒ 同样红）。
+    """
+    r = _cli(["--m0-instruments", "--l1-joint", "--append"])
+    assert r.returncode == 2, (r.returncode, r.stdout[-400:], r.stderr[-400:])
+    assert "--l1-joint 与 --append 互斥" in r.stderr, r.stderr[-400:]
