+def test_t5_emit_state_above_k_gives_fail_loud():
+    eng = _Eng()
+    m0 = _m0()
+    m0.attach(eng)
+    eng.signals._marks[0] = _L1_K                       # 绕过 attach 断言硬塞越档态
+    with pytest.raises(RuntimeError, match="接收态出现"):
