+# -*- coding: utf-8 -*-
+"""M1-SMOKE 读数器（砚，2026-10-05）：g15 首末 25% 时窗 + 存活 + 披露列。
+
+口径：
+- 窗切点 = M1 v1.1 §四 锁定（时基 25%）：前 25% 窗 = tick <= T/4，后 25% 窗 = tick > 3T/4；
+- J1 (L0-a) 方向 = 末段均值 >= 首段均值（逐 seed）；SMOKE 缩档 **不出 L0 判定**（R394② 会签口径④），只出定性半读数；
+- 发射率 = **不可测**（GAP-A 结论不等价，板 c0ab8be；G6 探针未建）——本脚本仅列 sig_run_len_hist 合计作审计旁证，不作发射率判据；
+- 会读 (J3) = g5_dir_diff/g5_move_diff 均值（G5 列，运行期即有）；
+- 存活 = summary.runs[].stop（"灭绝" vs "ticks"）+ 末行 pop。
+
+用法：py tools/m1_smoke_readout.py --data the-world-data/m1_smoke --ticks 2000
+"""
+from __future__ import annotations
+import argparse, csv, glob, json, os, re, statistics
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data", default="the-world-data/m1_smoke")
+    ap.add_argument("--ticks", type=int, default=2000)
+    a = ap.parse_args()
+    q1, q3 = a.ticks / 4.0, 3.0 * a.ticks / 4.0
+    print("seed | n_win | g15_first25 | g15_last25 | ratio | d_dir | alive@T | pop_end | pop_min | g5_dir_diff | g5_move_diff | n_sig | sum_sig_hist_rows")
+    for fp in sorted(glob.glob(os.path.join(a.data, "m1_smoke_d1700_s*_t2000.csv"))):
+        seed = re.search(r"_s(\d+)_t", os.path.basename(fp)).group(1)
+        rows = list(csv.DictReader(open(fp, encoding="utf-8")))
+        first = [float(r["g15_mean"]) for r in rows if float(r["tick"]) <= q1]
+        last = [float(r["g15_mean"]) for r in rows if float(r["tick"]) > q3]
+        pops = [float(r["pop"]) for r in rows]
+        d = float(statistics.mean(last)) - float(statistics.mean(first)) if first and last else float("nan")
+        ratio = float(statistics.mean(last)) / float(statistics.mean(first)) if first and last else float("nan")
+        summ_p = fp.replace(".csv", ".summary.json")
+        if os.path.exists(summ_p):
+            run0 = json.load(open(summ_p, encoding="utf-8"))["runs"][-1]
+            stop = run0.get("stop")
+            ext = run0.get("extinct_at")
+            alive = "EXTINCT" if (stop == "灭绝" or (ext is not None)) else "alive"
+        else:
+            stop, alive = "未完成", "unfinished"
+        g5d = [float(r["g5_dir_diff"]) for r in rows if r.get("g5_dir_diff") not in (None, "", "nan")]
+        g5m = [float(r["g5_move_diff"]) for r in rows if r.get("g5_move_diff") not in (None, "", "nan")]
+        nsig = [float(r["g5_n_sig"]) for r in rows if r.get("g5_n_sig") not in (None, "", "nan")]
+        sigcols = [k for k in rows[0].keys() if k.startswith("sig_run_len_hist_")]
+        sum_hist = sum(float(r[c]) for r in rows for c in sigcols if r.get(c) not in (None, "", "nan"))
+        alive = "灭绝" if (stop == "灭绝" or (ext is not None)) else "存活"
+        print(f"{seed} | {len(rows)} | {statistics.mean(first):.4f} | {statistics.mean(last):.4f} | {ratio:.4f} | {d:+.4f} | {alive}({stop}) | {pops[-1]:.0f} | {min(pops):.0f} | "
+              f"{statistics.mean(g5d):.4f} | {statistics.mean(g5m):.4f} | {statistics.mean(nsig):.0f} | {sum_hist:.0f}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
