+# -*- coding: utf-8 -*-
+"""E-056 M1 正式批读数器（砚，2026-10-06）。
+
+口径（全部已锁，引用不发明）：
+- 段切点 index 式 k=int(0.25n)（n=逐 run 采样行数；PI 裁②；C1 §8.7 同族）；
+- J1 g15 末段均值 ≥ 首段（逐 seed）；J2 发射率=**G6 原生** emit_rate_first/last/ratio
+  （summary run 级，窗宽 frac=0.25 同 index 式 floor，含 0 码口径=砚 A2 @板94f953a/骨架§八-4a，
+  emit_zero_pattern_n 单列披露可减扣）；J3 g5_dir_diff 均值 >0；
+- P3 同窗比门 @2000t pop_end ≥ 6945（锚×70%，双签 dcb6753）；生态门 R3/R6=多数存活至 2000t；
+- G4/P1-b（alphabet 8 恢复可测）：g4_mem_bit_frac 均值（>0 判定归 PI 复核，此处只出数）。
+NaN/缺列 ⇒ fail-loud 打印（N1 S4 条）。
+
+用法：py tools/e056_readout.py --data the-world-data/e056_m1
+"""
+from __future__ import annotations
+import argparse, csv, glob, json, os, re, statistics
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data", default="the-world-data/e056_m1")
+    ap.add_argument("--gate2k", type=float, default=6945.0)
+    a = ap.parse_args()
+    hdr = ("seed | n | g15_first | g15_last | g15_ratio | J1 | emit_first | emit_last | emit_ratio | J2 | "
+           "zero_pat | g5_dir | alive@2k | pop_end | P3 | pop_min_smp | g4_memfrac")
+    print(hdr)
+    agg = {"j1": 0, "j2": 0, "j3": 0, "p3": 0, "n": 0, "ratios": []}
+    bad = []
+    for fp in sorted(glob.glob(os.path.join(a.data, "e056_m1_d1700_s*_t2000.csv"))):
+        seed = re.search(r"_s(\d+)_t", os.path.basename(fp)).group(1)
+        rows = list(csv.DictReader(open(fp, encoding="utf-8")))
+        n = len(rows)
+        k = int(0.25 * n)
+        g15 = [float(r["g15_mean"]) for r in rows]
+        f15, l15 = statistics.mean(g15[:k]), statistics.mean(g15[-k:])
+        ratio = l15 / f15
+        summ = json.load(open(fp.replace(".csv", ".summary.json"), encoding="utf-8"))
+        r0 = [r for r in summ["runs"] if str(r.get("seed")) == seed or len(summ["runs"]) == 1][-1]
+        ef, el, er = r0["emit_rate_first"], r0["emit_rate_last"], r0["emit_rate_ratio"]
+        zp = r0.get("emit_zero_pattern_n")
+        g5 = [float(r["g5_dir_diff"]) for r in rows if r.get("g5_dir_diff") not in (None, "", "nan")]
+        g4 = [float(r["g4_mem_bit_frac"]) for r in rows if r.get("g4_mem_bit_frac") not in (None, "", "nan")]
+        pops = [float(r["pop"]) for r in rows]
+        alive = r0.get("stop") == "ticks" and pops[-1] > 0
+        j1, j2, j3 = l15 >= f15, (er >= 1.0 if er == er else None), (statistics.mean(g5) > 0 if g5 else None)
+        p3 = pops[-1] >= a.gate2k
+        for col, v in (("emit_rate_ratio", er), ("g15", ratio), ("g5", g5), ("g4", g4)):
+            if v is None or (isinstance(v, float) and v != v) or (col.startswith("g") and not v):
+                bad.append(f"s{seed}:{col}")
+        agg["n"] += 1
+        agg["j1"] += int(j1); agg["j2"] += int(bool(j2)); agg["j3"] += int(bool(j3))
+        agg["p3"] += int(p3); agg["ratios"].append(ratio)
+        print(f"{seed} | {n} | {f15:.4f} | {l15:.4f} | {ratio:.4f} | {'Y' if j1 else 'N'} | "
+              f"{ef:.4f} | {el:.4f} | {er:.4f} | {'Y' if j2 else ('N' if j2 is False else 'NaN')} | {zp} | "
+              f"{statistics.mean(g5):.4f} | {'ALV' if alive else 'EXT'}({r0.get('stop')}) | {pops[-1]:.0f} | "
+              f"{'Y' if p3 else 'N'} | {min(pops):.0f} | {statistics.mean(g4):.4f}")
+    print(f"AGG | N={agg['n']} J1末≥首 {agg['j1']}/{agg['n']} J2发射不降 {agg['j2']}/{agg['n']} "
